&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура БИТ_ДополнитьПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ТекущийОбъект.Ссылка.Пустая() Тогда
		Для каждого Строка Из ТекущийОбъект.Продукция Цикл
			Строка.БИТ_КлючСтроки = Новый УникальныйИдентификатор();
		КонецЦикла;
	КонецЕсли;
	
	НулевойUUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Для каждого Строка Из ТекущийОбъект.Продукция Цикл
		Если Строка.БИТ_КлючСтроки = Неопределено Или Строка.БИТ_КлючСтроки = "" ИЛИ Строка.БИТ_КлючСтроки = НулевойUUID Тогда
			Строка.БИТ_КлючСтроки = Новый УникальныйИдентификатор();
		КонецЕсли;
	КонецЦикла;
	
	ТекущийОбъект.БИТ_ДоработкиОбщийСтатусСтрок = ПолучитьОбщийСтатусСтрок();
КонецПроцедуры

&НаСервере
Функция ПолучитьТекущегоСотрудника()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Сотрудники.Физлицо = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Сотрудник;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВзятьВРаботуНаСервере(НомерСтрокиТЧПродукция)
	//ТекущийСотрудник = ПараметрыСеанса.ТекущийСотрудник; 
	ТекущийСотрудник = ПолучитьТекущегоСотрудника();
	Если ТекущийСотрудник = Справочники.Сотрудники.ПустаяСсылка() Тогда
		Сообщить("Не найден сотрудник в справочнике!");
		Возврат;
	КонецЕсли;
	// Получаем строку табличной части (нумерация с 0)
	СтрокаТЧ = Объект.Продукция[НомерСтрокиТЧПродукция - 1];
	
	Если СтрокаТЧ.Статус = Перечисления.СтатусыДокументовФасовка.Завершен Тогда
		Сообщить("Нельзя взять в работу завершенную позицию.");
		Возврат;
	КонецЕсли;
	Если СтрокаТЧ.Сотрудник <> ТекущийСотрудник И ЗначениеЗаполнено(СтрокаТЧ.Сотрудник) Тогда
		Сообщить("Строка уже занята сотрудником: " + СтрокаТЧ.Сотрудник);
		Возврат;
	КонецЕсли;
	
	// Заполняем данные
	СтрокаТЧ.Сотрудник = ТекущийСотрудник;
	СтрокаТЧ.Статус = Перечисления.СтатусыДокументовФасовка.Запланировано;
КонецПроцедуры

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	// 1. Проверяем, что выделена хотя бы одна строка
	Если Не Объект.Продукция.Количество() > 0 И Не Элементы.Продукция.ТекущаяСтрока = Неопределено Тогда
		Сообщить("Выделите строку продукции для начала работы.");
		Возврат;
	КонецЕсли;
	
	// 2. Получаем данные выделенной строки
	ТекущаяСтрока = Элементы.Продукция.ТекущиеДанные;
	
	// 4. Вызов сервера
	ВзятьВРаботуНаСервере(ТекущаяСтрока.НомерСтроки); // Передаем индекс строки
КонецПроцедуры

