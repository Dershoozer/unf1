		ПолноеИмяДокумента = "Документ.МаркировкаТоваровИСМП";
		ОписаниеОповещения = Неопределено;
		КорректировочныйДокумент = Ложь;
		
		Если КорректировочныйДокумент Тогда
			ПараметрыФормы = Новый Структура("Основание", Новый Структура("Основание, Корректировочный", Объект.Ссылка, КорректировочныйДокумент));
		Иначе
			ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
