			//Отказ = Истина;  // Запрещаем редактирование
			//Сообщить("Эта строка уже в работе у сотрудника " + ТекущиеДанные.Сотрудник);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияСтатусПриИзменении(Элемент) 
	ТекущаяСтрока = Элементы.Продукция.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.Статус = ПолучитьСтатусСтрокиВРаботе() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОСтатусе", ЭтотОбъект, ТекущаяСтрока), 
		"Вы уверены, что хотите взять эту позицию в работу?", 
		РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОСтатусе(Результат, Параметры) Экспорт
	ТекущаяСтрока = Параметры;
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		ТекущаяСтрока.Статус = ПолучитьСтатусСтрокиЗапланировано();
		ЗаписатьДокументНаСервере();
		ЭтаФорма.ОбновитьОтображениеДанных();
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда //статус строки в работе
		// Проверяем, записан ли документ
		Если Объект.Ссылка.Пустая() Тогда
			Сообщить("Документ должен быть записан перед упаковкой!");
			Возврат;
		КонецЕсли;
		
		// Проверяем, есть ли позиции в ТЧ
		Если Объект.Продукция.Количество() = 0 Тогда
			Сообщить("Нет позиций для упаковки!");
			Возврат;
		КонецЕсли;
		
		//Проверяем, что ИД строк все заполнены, если нет - просим пользователя перезаписать документ
		НулевойUUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		Для каждого Строка Из Объект.Продукция Цикл
			Если Строка.БИТ_КлючСтроки = Неопределено Или Строка.БИТ_КлючСтроки = "" ИЛИ Строка.БИТ_КлючСтроки = НулевойUUID Тогда
				Сообщить("Не созданы Идентификаторы строк, просьба перезаписать документ");
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		
		//Записываем документ - статус отдельно не записать, но без проведения!
		ЗаписатьДокументНаСервере();
		ЭтаФорма.ОбновитьОтображениеДанных();
		// Открываем форму упаковки
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("БИТ_КлючСтроки", ТекущаяСтрока.БИТ_КлючСтроки);
		ПараметрыФормы.Вставить("ПроизводствоОснование", Объект.Ссылка); 
		ПараметрыФормы.Вставить("ПродукцияТЧ", Объект.Продукция);
		
		//параметрыДляОбработкиСтатуса
		ПараметрыСтрокиДляСтатуса = Новый Структура;
		ПараметрыСтрокиДляСтатуса.Вставить("СтатусЗавершен", ПолучитьСтатусСтрокиЗавершен());
		ПараметрыСтрокиДляСтатуса.Вставить("БИТ_КлючСтроки", ТекущаяСтрока.БИТ_КлючСтроки);
		
		//ОткрытьФорму("Обработка.УпаковкаПродукции.Форма", ПараметрыФормы, ЭтаФорма); //просто открываем форму(СТАРАЯ ВЕРСИЯ)
		//Форма = ПолучитьФорму("Обработка.УпаковкаПродукции.Форма",ПараметрыФормы,ЭтаФорма);
		//Форма.СпособОтображенияОкна = ВариантСпособаОтображенияОкна.Максимизированное;
		//Форма.ВариантСпособаОтображенияОкна = ВариантСпособаОтображенияОкна.Максимизированное;
		//Форма = ПолучитьФорму("Обработка.УпаковкаПродукции.Форма",ПараметрыФормы,ЭтаФорма)
		//Форма.Открыть(, , ВариантСпособаОтображенияОкна.Максимизированное);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОбработкиУпаковки", ЭтотОбъект, ПараметрыСтрокиДляСтатуса);
		ОткрытьФорму("Обработка.УпаковкаПродукции.Форма", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОбработкиУпаковки(Результат, ПараметрыСтрокиДляСтатуса) Экспорт
	/////////////////////////////////////////////////////////
	НастроитьУсловноеОформлениеПоСтатусам();
	Если Результат = Истина Тогда
		ОбновитьСтатусУСтроки(ПараметрыСтрокиДляСтатуса.БИТ_КлючСтроки, ПараметрыСтрокиДляСтатуса.СтатусЗавершен);
		ЗаписатьДокументБезопасно(ПараметрыСтрокиДляСтатуса.БИТ_КлючСтроки, ПараметрыСтрокиДляСтатуса.СтатусЗавершен);
		ЭтаФорма.ОбновитьОтображениеДанных();
	КонецЕсли;
	
	
	//Для паллетов
	Если ПроверитьСуществованиеУпакованныхКоробов() Тогда
		Элементы.УпаковкаВПаллеты.Видимость = Истина;
		Элементы.УпаковкаВПаллеты.Доступность = Истина;
	Иначе
		Элементы.УпаковкаВПаллеты.Видимость = Ложь;
		Элементы.УпаковкаВПаллеты.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьСтатусУСтроки(БИТ_КлючСтроки, НовыйСтатус)
	//Сначала находим строку в документе
	//ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("БИТ_КлючСтроки", БИТ_КлючСтроки);
	НайденныеСтроки = Объект.Продукция.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() <> 1 Тогда
		Сообщить("не удалось автоматически изменить статус у строки на ""завершен"", просьба поменять самостоятельно");
	Иначе
		НайденныеСтроки[0].Статус = НовыйСтатус;
	КонецЕсли;
	
Конецпроцедуры

