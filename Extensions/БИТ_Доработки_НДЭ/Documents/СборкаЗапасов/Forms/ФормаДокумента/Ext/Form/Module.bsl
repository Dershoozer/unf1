&НаКлиенте
&После("ПриОткрытии")
Процедура Бит_ДополнитьПриОткрытии(Отказ)
	ОграниченияПросмотраДляЗоныУпаковки();
	// Проверяем, есть ли уже созданные короба для этого заказа
	// Используем синхронный вызов серверной функции
	Если ПроверитьСуществованиеУпакованныхКоробов() Тогда
		Элементы.УпаковкаВПаллеты.Видимость = Истина;
		Элементы.УпаковкаВПаллеты.Доступность = Истина;
	Иначе
		Элементы.УпаковкаВПаллеты.Видимость = Ложь;
		Элементы.УпаковкаВПаллеты.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		Элементы.БИТ_АвтоматическиСоздатьДокументМаркировки.Видимость = Истина;
		Элементы.БИТ_АвтоматическиСоздатьДокументМаркировки.Доступность = Истина;
	Иначе
		Элементы.БИТ_АвтоматическиСоздатьДокументМаркировки.Видимость = Ложь;
		Элементы.БИТ_АвтоматическиСоздатьДокументМаркировки.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

