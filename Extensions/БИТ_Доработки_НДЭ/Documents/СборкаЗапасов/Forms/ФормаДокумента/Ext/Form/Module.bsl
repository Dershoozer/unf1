&НаСервере
Процедура ЗаписатьДокументБезопасно(БИТ_КлючСтроки, СтатусЗавершен)
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		// Пробуем обычную запись
		Объект.БИТ_ДоработкиОбщийСтатусСтрок = ПолучитьОбщийСтатусСтрок();
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
		ЭтаФорма.Записать(ПараметрыЗаписи);
		
	Исключение
		// При ошибке - обновляем через объект
		//Если СтрНайти(ОписаниеОшибки(), "заблокирован") > 0 Тогда
			// Обновляем статус через объект в обход блокировки
		Попытка
			ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект <> Неопределено Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("БИТ_КлючСтроки", БИТ_КлючСтроки);
				НайденныеСтроки = ДокументОбъект.Продукция.НайтиСтроки(ПараметрыОтбора);
				
				Если НайденныеСтроки.Количество() = 1 Тогда
					НайденныеСтроки[0].Статус = СтатусЗавершен;
					ДокументОбъект.БИТ_ДоработкиОбщийСтатусСтрок = ПолучитьОбщийСтатусСтрок();
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
					//Сообщить("Статус обновлен в обход блокировки");
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Если опять ошибка - пробуем записать принудительно
			Попытка
				ДокументОбъект.БИТ_ДоработкиОбщийСтатусСтрок = ПолучитьОбщийСтатусСтрок();
				ДокументОбъект.Записать(Ложь);
				//Сообщить("Статус обновлен принудительно");
			Исключение
				//Сообщить("Не удалось обновить статус: " + ОписаниеОшибки());
			КонецПопытки;
		КонецПопытки;
		//КонецЕсли;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПредупреждения(Результат) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		// Пользователь подтвердил действие
		Сообщить("Позиция взята в работу.");
	Иначе
		// Пользователь отказался - нужно вернуть старый статус
		ТекущаяСтрока = Элементы.Продукция.ТекущиеДанные;
		Если ТекущаяСтрока <> Неопределено Тогда
			ТекущаяСтрока.Статус = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
