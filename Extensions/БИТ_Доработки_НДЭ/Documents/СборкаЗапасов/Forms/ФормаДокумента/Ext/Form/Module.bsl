		ПараметрыФормы.Вставить("БИТ_АвтосозданиеДокумента", Истина);
		
		ОткрытьФорму(ПолноеИмяДокумента + ".Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения);
