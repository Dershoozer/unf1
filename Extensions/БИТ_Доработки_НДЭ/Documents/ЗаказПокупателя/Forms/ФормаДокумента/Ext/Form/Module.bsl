&НаКлиенте
Процедура СоздатьДокументыФасовка(Команда) 
	
	// Проверяем, записан ли документ
	Если Объект.Ссылка.Пустая() Тогда
		Сообщить("Документ должен быть записан перед созданием фасовок!");
		Возврат;
	КонецЕсли;
	
	// Проверяем, не изменен ли объект после записи
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Документ должен быть записан перед созданием фасовок!");
		Возврат;
	КонецЕсли;
	
	// Проверяем, есть ли позиции в ТЧ
	Если Объект.Запасы.Количество() = 0 Тогда
		Сообщить("Нет позиций для фасовки!");
		Возврат;
	КонецЕсли;
	
	//Проверяем, что ИД строк все заполнены, если нет - просим пользователя перезаписать документ
	НулевойUUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Для каждого Строка Из Объект.Запасы Цикл
        Если Строка.БИТ_КлючСтроки = Неопределено Или Строка.БИТ_КлючСтроки = "" ИЛИ Строка.БИТ_КлючСтроки = НулевойUUID Тогда
            Сообщить("Не созданы Идентификаторы строк, просьба перезаписать документ");
			Возврат;
        КонецЕсли;
    КонецЦикла;
	
	// Показываем форму массового заполнения
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказОснование", Объект.Ссылка);
	ПараметрыФормы.Вставить("Запасы", Объект.Запасы);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	
	ОткрытьФорму("Обработка.СозданиеФасовок.Форма", ПараметрыФормы, ЭтаФорма, , , , Новый ОписаниеОповещения("ПослеСозданияФасовок", ЭтаФорма));
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокФасовок(Команда)
	
	// Открываем форму со списком всех фасовок по текущему заказу
	ПараметрыФормы = Новый Структура("ЗаказОснование", Объект.Ссылка); 
	ПараметрыФормы.Вставить("Запасы", Объект.Запасы);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ОткрытьФорму("Обработка.СписокФасовокПоЗаказу.Форма", ПараметрыФормы, ЭтаФорма, , , , Новый ОписаниеОповещения("ПослеЗакрытияСпискаФасовок", ЭтаФорма));
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеСозданияФасовок(Результат, ДопПараметры) Экспорт
    
	Если Результат = Истина Тогда
        ДокументыФасовкиСозданы = Истина;
        Элементы.СоздатьДокументыФасовка.Видимость = Ложь;
		Элементы.СоздатьДокументыФасовка.Доступность = Ложь;
        Элементы.ОткрытьСписокФасовок.Видимость = Истина;
		//Если ПроверитьСуществованиеФасовок() Тогда
		//	НастроитьУсловноеОформление();
		//КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры 

