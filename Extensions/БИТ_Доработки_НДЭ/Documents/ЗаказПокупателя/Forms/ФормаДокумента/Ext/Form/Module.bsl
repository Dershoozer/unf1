&НаКлиенте
&После("ПриОткрытии")
Процедура Бит_ДополнитьПриОткрытии(Отказ)
    
    // Проверяем, есть ли уже созданные фасовки для этого заказа
    // Используем синхронный вызов серверной функции
    Если ПроверитьСуществованиеФасовок() Тогда
        ДокументыФасовкиСозданы = Истина;
        Элементы.СоздатьДокументыФасовка.Видимость = Ложь;
        Элементы.ОткрытьСписокФасовок.Видимость = Истина;
    Иначе
        ДокументыФасовкиСозданы = Ложь;
        Элементы.СоздатьДокументыФасовка.Видимость = Истина;
        Элементы.ОткрытьСписокФасовок.Видимость = Ложь;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура БИТ_ДополнитьПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ТекущийОбъект.Ссылка.Пустая() Тогда
		Для каждого Строка Из ТекущийОбъект.Запасы Цикл
			Строка.БИТ_КлючСтроки = Новый УникальныйИдентификатор();
		КонецЦикла;
	КонецЕсли;
	
	НулевойUUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Для каждого Строка Из ТекущийОбъект.Запасы Цикл
        Если Строка.БИТ_КлючСтроки = Неопределено Или Строка.БИТ_КлючСтроки = "" ИЛИ Строка.БИТ_КлючСтроки = НулевойUUID Тогда
            Строка.БИТ_КлючСтроки = Новый УникальныйИдентификатор();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПроверитьСуществованиеФасовок()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(Фасовка.Ссылка) КАК Количество
    |ИЗ
    |   Документ.Фасовка КАК Фасовка
    |ГДЕ
    |   Фасовка.ДокументОснование = &Заказ";
    
    Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    
    Возврат Выборка.Количество > 0;
    
КонецФункции

