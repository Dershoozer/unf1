
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    
    // Проверяем, что документ новый (еще не сохранен)
    Если Ссылка.Пустая() Тогда
        
        // Определяем префикс в зависимости от станка
        Префикс = "00"; // по умолчанию
        
        Если ЗначениеЗаполнено(Станок) И ЗначениеЗаполнено(Станок.Артикул) Тогда
            // Замените "Станок А", "Станок Б" на реальные названия из вашей номенклатуры
            Префикс = Станок.Артикул;
        КонецЕсли;
        
        // Получаем последний использованный номер для этого префикса
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	ВЫРАЗИТЬ(ПРАВ(Фасовка.Номер, 8) КАК СТРОКА(8)) КАК НомераПоПрефиксу
        |ИЗ
        |	Документ.Фасовка КАК Фасовка
        |ГДЕ
        |	ЛЕВ(Фасовка.Номер, 3) ПОДОБНО &Префикс + ""-""";
        Запрос.УстановитьПараметр("Префикс", Строка(Префикс));
        
        Результат = Запрос.Выполнить();
		ТаблицаНомеров = Результат.Выгрузить();
		НоваяТаблица = Новый ТаблицаЗначений;
		НоваяТаблица.Колонки.Добавить("НомераПоПрефиксу", Новый ОписаниеТипов("Число"));
		// Добавляем остальные колонки из исходной таблицы
		Для Каждого Колонка Из ТаблицаНомеров.Колонки Цикл
		    Если Колонка.Имя <> "НомераПоПрефиксу" Тогда
		        НоваяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		    КонецЕсли;
		КонецЦикла;

		// Заполняем новую таблицу
		Для Каждого СтрокаТаблицы Из ТаблицаНомеров Цикл
		    НоваяСтрока = НоваяТаблица.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		    НоваяСтрока.НомераПоПрефиксу = Число(СтрокаТаблицы.НомераПоПрефиксу);
		КонецЦикла;

		ТаблицаНомеров = НоваяТаблица;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таблица.НомераПоПрефиксу КАК НомерЧисло
		               |ПОМЕСТИТЬ ПреобразованнаяВТ
		               |ИЗ
		               |	&Таблица КАК Таблица
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МАКСИМУМ(ПреобразованнаяВТ.НомерЧисло) КАК МаксНомер
		               |ИЗ
		               |	ПреобразованнаяВТ КАК ПреобразованнаяВТ";
		Запрос.УстановитьПараметр("Таблица", ТаблицаНомеров);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
        Выборка.Следующий();
        
        МаксНомер = Выборка.МаксНомер;
        Если МаксНомер = 0 ИЛИ НЕ ЗначениеЗаполнено(МаксНомер) Тогда
            НовыйНомер = 1;
        Иначе
            НовыйНомер = МаксНомер + 1;
		КонецЕсли;
		НеобходимаяДлина = 8 - СтрДлина(Строка(НовыйНомер));
		СтрокаНулей = Лев("00000000", НеобходимаяДлина);
		НовыйНомер = СтрокаНулей + СтрЗаменить(Строка(НовыйНомер), " ", "");
        
        // Присваиваем номер в формате "префикс-XXXXXX"
        Номер = Строка(Префикс) + "-" + НовыйНомер;
        
    КонецЕсли;
    
КонецПроцедуры












