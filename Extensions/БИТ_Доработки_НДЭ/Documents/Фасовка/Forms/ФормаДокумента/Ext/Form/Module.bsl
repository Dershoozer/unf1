
#Область НастройкаПолейФормыИОтборов
&НаКлиенте
Процедура СтанокНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)	
	// Отключаем стандартную обработку
	СтандартнаяОбработка = Ложь;
	
	// Вызываем серверную процедуру для получения ссылки на категорию
	ОборудованиеСсылка = ПолучитьКатегориюОборудованиеНаСервере();
	
	// Создаем оповещение для обработки выбора
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборОборудования", ЭтотОбъект);
	
	Если ОборудованиеСсылка <> Неопределено Тогда
		// Создаем отбор
		Отбор = Новый Структура("КатегорияНоменклатуры", ОборудованиеСсылка);
		
		// Параметры открытия формы выбора
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("Отбор", Отбор);
		
		// Открываем форму выбора с оповещением
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент, , , , Оповещение);
	Иначе
		// Если категория не найдена, открываем обычный выбор
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", , Элемент, , , , Оповещение);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьКатегориюОборудованиеНаСервере()
	Возврат Справочники.КатегорииНоменклатуры.НайтиПоНаименованию("Оборудование");
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОборудования(ВыбранноеЗначение, ПараметрыВыбора) Экспорт	
	Если ВыбранноеЗначение = Неопределено Тогда
		Объект.Станок = ВыбранноеЗначение;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеВыбораДляПоляВвода(Текст)

    ДанныеВыбора = Новый СписокЗначений;
    ОборудованиеСсылка = ПолучитьКатегориюОборудованиеНаСервере();
	Если ОборудованиеСсылка = Неопределено Тогда
		Возврат ДанныеВыбора;
	КонецЕсли;
	
	Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	Номенклатура.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |	Номенклатура.КатегорияНоменклатуры = &КатегорияНоменклатуры
    |	И (Номенклатура.Наименование ПОДОБНО &Шаблон
    |			ИЛИ Номенклатура.Артикул ПОДОБНО &Шаблон)
    |
    |УПОРЯДОЧИТЬ ПО
    |	Номенклатура.Наименование";
    
    Запрос.УстановитьПараметр("КатегорияНоменклатуры", ОборудованиеСсылка);
    Запрос.УстановитьПараметр("Шаблон", "%" + Текст + "%");

    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат ДанныеВыбора;
    КонецЕсли;
    
    ТаблицаЗапроса = Результат.Выгрузить();
    ДанныеВыбора.ЗагрузитьЗначения(ТаблицаЗапроса.ВыгрузитьКолонку("Ссылка"));
    
    Возврат ДанныеВыбора; 
	
КонецФункции

&НаКлиенте
Процедура СтанокАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

    Если Не ПустаяСтрока(Текст) Тогда
        СтандартнаяОбработка = Ложь;
        ДанныеВыбора = ПолучитьДанныеВыбораДляПоляВвода(Текст);
    КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	// Отключаем стандартный механизм выбора, чтобы подставить свой список
	СтандартнаяОбработка = Ложь;
	
	// Получаем список сотрудников-фасовщиков с сервера
	МассивСсылок = ПолучитьФасовщиковНаСервере();
	
	// Очищаем старый список и загружаем новый
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.ЗагрузитьЗначения(МассивСсылок);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьФасовщиковНаСервере()
	
	// 1. Получаем актуальные должности на текущую дату из регистра сведений
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка,
	|	СотрудникиСрезПоследних.Должность КАК Должность
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.Сотрудники.СрезПоследних КАК СотрудникиСрезПоследних
	|		ПО Сотрудники.Ссылка = СотрудникиСрезПоследних.Сотрудник
	|ГДЕ
	|	Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И Сотрудники.Наименование ПОДОБНО &Родитель
	|	И Сотрудники.Недействителен = ЛОЖЬ
	|	И Сотрудники.ВАрхиве = ЛОЖЬ
	|	И СотрудникиСрезПоследних.Должность.Наименование ПОДОБНО &Наименование";  
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СотрудникиСрезПоследних.Сотрудник КАК Сотрудник,
	|	СотрудникиСрезПоследних.Должность КАК Должность,
	|	СотрудникиСрезПоследних.Должность.Наименование КАК ДолжностьНаименование
	|ИЗ
	|	РегистрСведений.Сотрудники.СрезПоследних КАК СотрудникиСрезПоследних
	|		внутреннее СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО СотрудникиСрезПоследних.Сотрудник = Сотрудники.Ссылка
	|ГДЕ
	|	СотрудникиСрезПоследних.Должность.Наименование ПОДОБНО &Должность
	|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И Сотрудники.Родитель.Наименование ПОДОБНО &Родитель
	|	И Сотрудники.ВАрхиве = ЛОЖЬ";
	
	// 2. Настройка параметров (ищем слова "фасовщик" в любом месте)
	Запрос.УстановитьПараметр("Должность", "%фасовщик%");
	Запрос.УстановитьПараметр("Родитель", "склад");
	
	// 3. Выполняем и выгружаем результат в простой массив
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");
	
	Возврат Результат;
	
КонецФункции 

#КонецОбласти 


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    // Заполняем автора, только если это новый документ и поле еще не заполнено
    Если НЕ ЗначениеЗаполнено(Объект.Автор) И Объект.Ссылка.Пустая() Тогда
        Объект.Автор = Пользователи.ТекущийПользователь();
		Объект.Организация = Справочники.Организации.НайтиПоНаименованию("Дубровский Андрей Леонидович");
		Объект.СтатусДокумента = Перечисления.СтатусыДокументовФасовка.ВРаботе;
    КонецЕсли;

КонецПроцедуры


