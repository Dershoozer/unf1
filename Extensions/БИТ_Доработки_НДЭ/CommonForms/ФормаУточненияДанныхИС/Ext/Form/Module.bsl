#Область ОбработчикиСобытийФормы

&НаКлиенте
&После("ПриОткрытии")
Процедура БИТ_ПриОткрытииПосле(Отказ)
	Если ПолучитьБИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности() Тогда
		ПодключитьОбработчикОжидания("БИТ_ВыполнитьАвтозаполнение", 0.5, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьБИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности()
	Возврат Константы.БИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности.Получить();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура БИТ_ВыполнитьАвтозаполнение() Экспорт
	
	ОтключитьОбработчикОжидания("БИТ_ВыполнитьАвтозаполнение");
	
	// Заполняем срок годности из реквизита Бит_СрокГодности
	ЗаполнитьСрокГодностиИзРеквизитаНаСервере();
	
	// Устанавливаем галку "Запомнить выбор"
	УстановитьЗапомнитьВыбор();
	
	// Проверяем заполненность и закрываем
	ПроверитьИЗакрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокГодностиИзРеквизитаНаСервере()
	
	// Проверяем, нужно ли заполнять срок годности
	Если Не УказатьСрокГодности Тогда
		Возврат;
	КонецЕсли;
	
	// Если срок уже заполнен - пропускаем
	Если ЗначениеЗаполнено(ГоденДо) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, не код маркировки со сроком годности
	Если ЭтоКодМаркировкиСоСрокомГодности Тогда
		Возврат;
	КонецЕсли;
	
	// Если номенклатура не заполнена - пропускаем
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем Бит_СрокГодности из номенклатуры
	БитСрокГодности = ПолучитьБитСрокГодности(Номенклатура);
	
	Если ЗначениеЗаполнено(БитСрокГодности) Тогда
		ГоденДо = ДобавитьМесяц(ТекущаяДата(), БитСрокГодности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗапомнитьВыбор()
	
	// Устанавливаем галку "Запомнить выбор"
	Если ПараметрыСканирования.Свойство("ИспользуютсяДанныеВыбораПоМаркируемойПродукции") 
		И ПараметрыСканирования.ИспользуютсяДанныеВыбораПоМаркируемойПродукции Тогда
		ЗапомнитьВыбор = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрыть()
	
	// Проверяем заполненность всех обязательных реквизитов
	Отказ = Ложь;
	ПроверитьЗаполнениеНаСервере(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Закрываем форму через штатный механизм
	ЗакрытьФорму();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеНаСервере(Отказ)
	
	// Проверка заполненности обязательных реквизитов
	Если Не ЗначениеЗаполнено(Номенклатура) 
		И Не ПараметрыСканирования.РазрешенаОбработкаКодовСПустойНоменклатурой Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ХарактеристикиИспользуются И Не ЗначениеЗаполнено(Характеристика) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИнтеграцияИСКлиентСервер.НеобходимоУказатьСерию(СтатусУказанияСерий) 
		И Не ЗначениеЗаполнено(Серия) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если УказатьИдентификаторВЕТИС 
		И Не ЗначениеЗаполнено(ИдентификаторПроисхожденияВЕТИС) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если УказатьСрокГодности 
		И Не ЗначениеЗаполнено(ГоденДо) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьБитСрокГодности(Номенклатура)
	
	Попытка
		Возврат Номенклатура.Бит_СрокГодности;
	Исключение
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.БИТ_СрокГодности КАК БитСрокГодности
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	Попытка
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.БитСрокГодности;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти