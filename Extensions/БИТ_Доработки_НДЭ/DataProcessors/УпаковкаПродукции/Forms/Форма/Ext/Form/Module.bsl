&НаСервере
Функция ПолучитьКоличествоУпакованныхВКороб(ШтрихкодКороба)
	// Создаем запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.СобраноВКороб КАК СобраноВКороб,
	|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование = &ДокументОснование
	|	И УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании = &НомерСтрокиВДокументеОсновании
	|	И УпаковкаПродукцииКодыМаркировки.СобраноВКороб = ИСТИНА
	|	И УпаковкаПродукцииКодыМаркировки.ШтрихкодКороба = &ШтрихкодКороба";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ПроизводствоСсылка);
	Запрос.УстановитьПараметр("НомерСтрокиВДокументеОсновании", Объект.БИТ_КлючСтроки);
	Запрос.УстановитьПараметр("ШтрихкодКороба", ШтрихкодКороба);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	КоличествоНаборов = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Тип = "Набор" Тогда
			КоличествоНаборов = КоличествоНаборов + 1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоНаборов = 0 Тогда
		ТаблицаЗначений = Результат.Выгрузить();
		Возврат ТаблицаЗначений.Количество();
	КонецЕсли;
	Возврат КоличествоНаборов;
КонецФункции

&НаСервере
Функция ПолучитьЗначениеДопРеквизитаКороб(НоменклатураСсылка)
	 
	ОбъектНоменклатуры = НоменклатураСсылка.ПолучитьОбъект();
	
	ЭлементПВХ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "КолвоВОтгрузочнойКоробке_46ce489ccc8b43f1a0f2ee82e9be3e64");
	 Если ЭлементПВХ.Пустая() Тогда
        Возврат Неопределено;
	КонецЕсли;
	СвойствоЗначение = ОбъектНоменклатуры.ДополнительныеРеквизиты.Найти(ЭлементПВХ, "Свойство");
	Если СвойствоЗначение <> Неопределено Тогда
	    ЗначениеДопРеквизитаКолвоВКоробке = СвойствоЗначение.Значение; 
	Иначе
		ЗначениеДопРеквизитаКолвоВКоробке = Неопределено;
	КонецЕсли;
	Если ЗначениеДопРеквизитаКолвоВКоробке <> Неопределено Тогда
		Возврат ЗначениеДопРеквизитаКолвоВКоробке;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеВводаКодаМаркировки(Результат,эмм) Экспорт
	/////////////////////////////////////////////////////////
	Если Результат <> Неопределено И Результат <> "" Тогда
		//обновляем РС
		ОбновитьСтатусПоКодуМаркировки(Результат);
		
		////озвучиваем количество номер сколько уже упаковано в короб
		КоличествоУпакованных = ПолучитьКоличествоОтсканированных();
		КоличествоВсехКодовМаркировки = ПолучитьКоличествоВсехКодовМаркировкиПоСтроке();
		//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку");
		СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку";
		//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку");
		//проверяем на завершение
		Если ВсяУпаковкаЗавершена() Тогда
			Элементы.НачатьУпаковку.Заголовок = "Упаковка завершена";
			Сообщить("Упаковка полностью завершена, все КМ отсканированы");
			Возврат;
		КонецЕсли;
		//получаем следующие коды маркировки
		ПараметрыСтруктура = ПолучитьКодыМаркировки();
		Если ПараметрыСтруктура = Неопределено Тогда
			Сообщить("нет данных по регистр сведений УпаковкаПродукцииКодыМаркировки");
			Возврат;
		КонецЕсли;
		ПараметрыСтруктура.Вставить("СтрокаНумерацииУпакованных", СтрокаНумерацииУпакованных);
		
		//дальше запускаем окно, пока не нажмется отмена или вся упаковка не завершится
		Оповещение = Новый ОписаниеОповещения("ПослеВводаКодаМаркировки", ЭтотОбъект);
		ОткрытьФорму("Обработка.УпаковкаПродукции.Форма.ВводКода", ПараметрыСтруктура, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// Пользователь нажал Отмена или закрыл диалог
		Сообщить("Ввод отменен");
		Возврат;
	КонецЕсли;
КонецПроцедуры

