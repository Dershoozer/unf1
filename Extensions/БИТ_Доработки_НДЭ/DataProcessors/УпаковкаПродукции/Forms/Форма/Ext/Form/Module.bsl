&НаСервере
Функция ПолучитьКодыМаркировки()
	//получаем ТаблицаЗначений всего РС по строке в производстве, уже отсортировано по индексу
	ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки);
	//проверяем сразу на количество
	Если ТаблицаЗначенийУпаковки.Количество() < 1 Тогда
		Сообщить("по текущей строке не создана упаковка, регистр сведений УпаковкаПродукцииКодыМаркировки не заполнен");
		Возврат Неопределено;
	КонецЕсли;
	
	//создаем структуру для передачи параметров
	МассивКодовМаркировкиНеотсканированных = Новый Массив;
	ПараметрыДляВводаКода = Новый Структура;
	ПараметрыДляВводаКода.Вставить("МассивКодовМаркировкиНеотсканированных", МассивКодовМаркировкиНеотсканированных);
	ПараметрыДляВводаКода.Вставить("Тип", "");
	ПараметрыДляВводаКода.Вставить("НоменклатураСборки", "");
	ПараметрыДляВводаКода.Вставить("ШтрихкодНоменклатураСборки", "");
	
	
	//теперь надо по первой строке определить тип - у первой строки может быть только набор или Дойпак
	//Если набор - проверяем отсканированные, находим не отсканированный
	Если ТаблицаЗначенийУпаковки[0].Тип = "Набор" Тогда
		
		Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
			//Нужно найти неотсканированный набор 
			Если СтрокаТаблицыЗначенийУпаковки.Отсканировано = Истина Тогда//если отсканирован, идем к следующему
				Продолжить;
			Иначе//проверяем все ли отсканированы КМ у набора, сам набор сканируется последним
				ТаблицаЗначенийНабора = ПолучитьИзРегистраУпаковкаПродукцииКодыМаркировкиУнабора(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки, СтрокаТаблицыЗначенийУпаковки.НомерНабора);
				ВсеОтсканированы = Истина;
				Для Каждого СтрокаТаблицыНабора Из ТаблицаЗначенийНабора Цикл
					Если СтрокаТаблицыНабора.Отсканировано = Ложь Тогда//формируем массив неотсканированных у набора
						ПараметрыДляВводаКода.МассивКодовМаркировкиНеотсканированных.Добавить(СтрокаТаблицыНабора.КодМаркировки);
						ВсеОтсканированы = Ложь;
					КонецЕсли;
				КонецЦикла;
				Если ВсеОтсканированы Тогда //передаем сам КМ набора и прерываем цикл
					ПараметрыДляВводаКода.МассивКодовМаркировкиНеотсканированных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
					ПараметрыДляВводаКода.Тип = "Набор";
					ПараметрыДляВводаКода.НоменклатураСборки = СтрокаТаблицыЗначенийУпаковки.Номенклатура;
					ПараметрыДляВводаКода.ШтрихкодНоменклатураСборки = СтрокаТаблицыЗначенийУпаковки.Номенклатура.Штрихкод;
					Прервать;
				КонецЕсли;
				ПараметрыДляВводаКода.Тип = "ЧастьНабора";
				ПараметрыДляВводаКода.НоменклатураСборки = СтрокаТаблицыЗначенийУпаковки.Номенклатура;
				ПараметрыДляВводаКода.ШтрихкодНоменклатураСборки = СтрокаТаблицыЗначенийУпаковки.Номенклатура.Штрихкод;
				Прервать; //тогда есть неотсканированные, их уже добавили в массив, прерываем цикл
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТаблицаЗначенийУпаковки[0].Тип = "Дойпак" Тогда //если дойпак - у нас нужно просто добавить неотсканированные КМ
		
		Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
			Если СтрокаТаблицыЗначенийУпаковки.Отсканировано = Ложь Тогда
				ПараметрыДляВводаКода.МассивКодовМаркировкиНеотсканированных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
		ПараметрыДляВводаКода.Тип = "Дойпак";
		ПараметрыДляВводаКода.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
		ПараметрыДляВводаКода.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
		
	КонецЕсли;
	
	//передаем структуру
	Возврат ПараметрыДляВводаКода;
КонецФункции

&НаСервере
Процедура НДЭ()
	Если Объект.ИспользуемыйСклад = 1 Тогда
			СоздатьШтрихкодыДляКоробовОЗОН();
		КонецЕсли;
		
		ТаблицаМонопаллетов = ПолучитьТаблицуВсехМоноПаллетовПоДокументу();
		Если ТаблицаМонопаллетов <> Неопределено Тогда
			Если Объект.ИспользуемыйСклад = 2 И ТаблицаМонопаллетов.Количество() > 0 Тогда
				СоздатьШтрихкодыДляКоробовВБПриМонопаллете();
			КонецЕсли;
		КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьУпаковку(Команда)
	
	//НДЭ();
	
	Если ВсяУпаковкаЗавершена() Тогда
		Если НачатаУпаковкаВКороба() Тогда
			Если ВсяУпаковкаВКоробаЗавершена() Тогда
				ОзвучитьТекст("Все отгрузочные короба собраны");
				Сообщить("упаковка строки полностью завершена");
				Возврат;
			Иначе
				НачатьИлиПродолжитьУпаковкуВКороба();
			КонецЕсли;
		Иначе
			ТекстВопроса = "Упаковка полностью завершена, все КМ отсканированы. Начать упаковку в короба?";
			ПоказатьВопрос(Новый ОписаниеОповещения("ЗавершениеУпаковкиВопросЗавершен", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;//обязательно прерываем
		КонецЕсли;
	Иначе
		НачатьИлиПродолжитьУпаковкуПоНаборам();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьИлиПродолжитьУпаковкуПоНаборам()
	//если набор
	//Необходимо брать первый набор, проверять у него отсканированные части набора, если нет - передавать, если да - следующий набор и из него дойпак, передача массива
	//
	//если дойпак
	//передавать массив неотсканенных
	//РАБОТАЕМ ТОЛЬКО С КОДАМИ МАРКИРОВКИ - ПЕРЕДАЧА МАССИВА ДОЙПАКОВ ИЛИ ЧАСТЕЙ НАБОРА, ЕСЛИ НАБОР - ПАРАМЕТР КОДА МАРКИРОВКИ НАБОРА
	//ПОЧЕМУ:
	//у наборов - одинаковый GTIN(по номенклатуре)
	//у наборов и частей набора - одинаковый штрихкод упаковки(уникальный) и номер набора(только по ид строки)
	//у частей набора - одинаковый GTIN(по номенклатуре)
	//дойпак
	//одинаковый GTIN(по номенклатуре), нет штрихкода упаковки 
	
	//в РС так же есть 3 типа(Набор, ЧастьНабора, Дойпак), "Отсканировано"
	
	////озвучиваем количество номер сколько уже упаковано в короб
		КоличествоУпакованных = ПолучитьКоличествоОтсканированных();
		КоличествоВсехКодовМаркировки = ПолучитьКоличествоВсехКодовМаркировкиПоСтроке();
		//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку");
		СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку";
		//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВсехКодовМаркировки) + " собрано в упаковку");
	
	//РАЗРАБОТКА - сначала получаем коды маркировки массив не отсканенных + доп параметры - если набор - код маркировки набора, так же тип передаем
	ПараметрыСтруктура = ПолучитьКодыМаркировки();
	Если ПараметрыСтруктура = Неопределено Тогда
		Сообщить("нет данных по регистр сведений УпаковкаПродукцииКодыМаркировки");
		Возврат;
	КонецЕсли;
	ПараметрыСтруктура.Вставить("СтрокаНумерацииУпакованных", СтрокаНумерацииУпакованных);
	
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКодаМаркировки", ЭтотОбъект);
	ОткрытьФорму("Обработка.УпаковкаПродукции.Форма.ВводКода", ПараметрыСтруктура, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НачатьИлиПродолжитьУпаковкуВКороба()
	Элементы.ПоказатьДеревоЗначений.Видимость = Истина;
	Элементы.ПоказатьДеревоЗначений.Доступность = Истина;
	//если набор
	//Необходимо брать все наборы КМ не упакованных, так же смотреть на каком коробе остановились-  передача массива
	//
	//если дойпак
	//передавать массив всех дойпаков
	
	//в РС так же есть 3 типа(Набор, ЧастьНабора, Дойпак), "Отсканировано"
	
	//РАЗРАБОТКА - сначала получаем коды маркировки массив не отсканенных + доп параметры - если набор - код маркировки набора, так же тип передаем
	ПараметрыСтруктура = ПолучитьКодыМаркировкиДляКороба();
	Если ПараметрыСтруктура = Неопределено Тогда
		Сообщить("Ошибка ПриПолученииКодовМаркировки для коробов");
		Возврат;
	КонецЕсли;
	ПараметрыСтруктура.Вставить("ИспользуемыйСклад", Объект.ИспользуемыйСклад);
	
	ПараметрыПослеУдачногоВвода = Новый Структура;
	ПараметрыПослеУдачногоВвода.Вставить("ШККороба",ПараметрыСтруктура.ШККороба);
	ПараметрыПослеУдачногоВвода.Вставить("ВыводитьПечатьШККороба", ПараметрыСтруктура.ВыводитьПечатьШККороба);
	
	////озвучиваем количество номер сколько уже упаковано в короб
	КоличествоУпакованных = ПолучитьКоличествоУпакованныхВКороб(ПараметрыСтруктура.ШККороба);
	КоличествоВОдномКоробеВКарточкеНоменклатуры = ПолучитьЗначениеДопРеквизитаКороб(Объект.ТекущаяНоменклатура);
	//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб");
	СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб";
	//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб");
	ПараметрыСтруктура.Вставить("СтрокаНумерацииУпакованных", СтрокаНумерацииУпакованных);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКодаМаркировкиДляКороба", ЭтотОбъект, ПараметрыПослеУдачногоВвода);
	ОткрытьФорму("Обработка.УпаковкаПродукции.Форма.ВводКороба", ПараметрыСтруктура, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Функция ПолучитьКодыМаркировкиДляКороба()
	//получаем ТаблицаЗначений всего РС по строке в производстве, уже отсортировано по индексу
	ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки);
	//проверяем сразу на количество
	Если ТаблицаЗначенийУпаковки.Количество() < 1 Тогда
		Сообщить("по текущей строке не создана упаковка, регистр сведений УпаковкаПродукцииКодыМаркировки не заполнен");
		Возврат Неопределено;
	КонецЕсли;
	
	//проверяем короба соответствие
	//сначала по карточке номенклатуры
	ОбщееКоличествоНоменклатуры = Объект.КоличествоНоменклатуры;
	КоличествоВОдномКоробеВКарточкеНоменклатуры = ПолучитьЗначениеДопРеквизитаКороб(Объект.ТекущаяНоменклатура);
	Если КоличествоВОдномКоробеВКарточкеНоменклатуры = Неопределено ИЛИ КоличествоВОдномКоробеВКарточкеНоменклатуры = 0 Тогда
		Сообщить("Не задано кол-во коробов в карточке номенклатуры!");
		Возврат Неопределено;
	КонецЕсли;
	НужноКоробов = Цел(ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры);
	ДробнаяЧасть = ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры;
	Если  НужноКоробов <> ДробнаяЧасть Тогда
		НужноКоробов = НужноКоробов + 1;
	КонецЕсли;
	//после по зарезервированным штрихкодам коробов
	ТаблицаЗначенийКоробовПоНоменклатуре = ПолучитьТаблицуЗначенийКоробов(ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод);//по первому можно, так как отсортировано
	Если ТаблицаЗначенийКоробовПоНоменклатуре.Количество() < 1 Тогда
		Сообщить("по текущей строке не заполнен регистр сведений ДанныеПоКоробам!");
		Возврат Неопределено;
	КонецЕсли;
	ЗарезервированноеКоличествоКоробов = ТаблицаЗначенийКоробовПоНоменклатуре[ТаблицаЗначенийКоробовПоНоменклатуре.Количество()-1].ПорядковыйНомерКороба;//таблица отсортирована по возрастанию
	//сравнием их для надежности
	Если ЗарезервированноеКоличествоКоробов <> НужноКоробов Тогда
		Сообщить("ЗарезервированноеКоличествоКоробов не совпадает с НеобходимымКоличествомКоробов: " + ЗарезервированноеКоличествоКоробов + "<>" + НужноКоробов);
		Возврат Неопределено;
	КонецЕсли;
	/////////////////////////////////
	//Проверки прошли
	//ТаблицаЗначенийУпаковки - вся тч по маркировкам с коробами
	//ТаблицаЗначенийКоробовПоНоменклатуре - вся тч по ШККороба и номером
	//ЗарезервированноеКоличествоКоробов - сколько нужно коробов
	//КоличествоВОдномКоробеВКарточкеНоменклатуры
	
	//создаем структуру для передачи параметров
	МассивКодовМаркировкиНеУпакованных = Новый Массив;
	ПараметрыДляВводаКороба = Новый Структура;
	ПараметрыДляВводаКороба.Вставить("МассивКодовМаркировкиНеУпакованных", МассивКодовМаркировкиНеУпакованных);
	ПараметрыДляВводаКороба.Вставить("Тип", "");
	ПараметрыДляВводаКороба.Вставить("ШККороба", "");
	ПараметрыДляВводаКороба.Вставить("НоменклатураСборки", "");
	ПараметрыДляВводаКороба.Вставить("ШтрихкодНоменклатураСборки", "");
	ПараметрыДляВводаКороба.Вставить("ВыводитьПечатьШККороба", Ложь);
	
	////////////////////////////////
	//теперь нужно проверить начата ли упаковка
	Если НачатаУпаковкаВКороба() Тогда
		//нужно найти на каком шк коробе остановились
		ТаблицаЗначенийИспользованныхКоробов = ПолучитьШККоробовИспользованных();
		Если ТаблицаЗначенийИспользованныхКоробов.Количество() < 1 Тогда
			Сообщить("не удалось получить таблицу использованных коробов");
			Возврат неопределено;
		КонецЕсли;
		ПоследнийИспользованныйШККоробаПоПорядку = ТаблицаЗначенийИспользованныхКоробов[ТаблицаЗначенийИспользованныхКоробов.Количество()-1].ШтрихкодКороба;
		ПараметрыДляВводаКороба.ШККороба = ПоследнийИспользованныйШККоробаПоПорядку;
		ПоследнийПорядковыйНомерКоробаПоПорядку = ТаблицаЗначенийИспользованныхКоробов[ТаблицаЗначенийИспользованныхКоробов.Количество()-1].ПорядковыйНомерКороба;
		//теперь нужно проверить все ли упаковано в этот короб и является ли он последним
		Если ПоследнийПорядковыйНомерКоробаПоПорядку = ЗарезервированноеКоличествоКоробов Тогда
			//последний короб может быть заполнен не полностью, нужно найти наборы неупакованные и их полный массив передать
			Если ТаблицаЗначенийУпаковки[0].Тип = "Набор" Тогда
				
				Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
					Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //на часть набора первым попасть не можем, таблица отсортирована
						Продолжить;
					ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Набор" Тогда
						ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
					КонецЕсли;
				КонецЦикла;
				ПараметрыДляВводаКороба.Тип = "Набор";
				ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
				ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
				
			ИначеЕсли ТаблицаЗначенийУпаковки[0].Тип = "Дойпак" Тогда
				
				Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
					Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //передаем все НеУпакованные
						Продолжить;
					ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Дойпак" Тогда
						ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
					КонецЕсли;
				КонецЦикла;
				ПараметрыДляВводаКороба.Тип = "Дойпак";
				ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
				ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
				
			КонецЕсли;
			//получаем шкКороба последнего
			ПараметрыДляВводаКороба.ШККороба = ТаблицаЗначенийКоробовПоНоменклатуре[ЗарезервированноеКоличествоКоробов-1].ШККороба
			
		Иначе
			//если у нас какой то короб, но не последний, надо посмотреть сколько в него еще умещается - для этого получить уже Упакованные и сравнить с вмещением
			Если ТаблицаЗначенийУпаковки[0].Тип = "Набор" Тогда
				
				ТаблицаЗначенийУпакованных = ПолучитьТаблицуЗначенийУпакованныхВКороб(ПоследнийИспользованныйШККоробаПоПорядку, "Набор");
				СколькоУжеУпакованоПоШККоробу = ТаблицаЗначенийУпакованных.Количество();
				Если КоличествоВОдномКоробеВКарточкеНоменклатуры = СколькоУжеУпакованоПоШККоробу Тогда//если уже укомплектован этот короб, то получаем следующий 
					
					ФлагНайденного = Ложь;
					Для Каждого СтрокаТаблицаЗначенийКоробовПоНоменклатуре Из ТаблицаЗначенийКоробовПоНоменклатуре Цикл
						Если ФлагНайденного Тогда
							ПараметрыДляВводаКороба.ШККороба = СтрокаТаблицаЗначенийКоробовПоНоменклатуре.ШККороба;
							Прервать;
						КонецЕсли;
						Если СтрокаТаблицаЗначенийКоробовПоНоменклатуре.ШККороба = ПоследнийИспользованныйШККоробаПоПорядку Тогда
							ФлагНайденного = Истина;
						КонецЕсли;
					КонецЦикла;
					Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
						Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //на часть набора первым попасть не можем, таблица отсортирована
							Продолжить;
						ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Набор" Тогда
							ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
						КонецЕсли;
					КонецЦикла;
					ПараметрыДляВводаКороба.Тип = "Набор";
					ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
					ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
					
				Иначе
					
					Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
					Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //на часть набора первым попасть не можем, таблица отсортирована
						Продолжить;
					ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Набор" Тогда
						ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
					КонецЕсли;
					КонецЦикла;
					ПараметрыДляВводаКороба.Тип = "Набор";
					ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
					ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
					Если КоличествоВОдномКоробеВКарточкеНоменклатуры - СколькоУжеУпакованоПоШККоробу = 1 Тогда//печатаем ШК короба, если не хватает всего одного дойпака
						ПараметрыДляВводаКороба.ВыводитьПечатьШККороба = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ТаблицаЗначенийУпаковки[0].Тип = "Дойпак" Тогда
				
				ТаблицаЗначенийУпакованных = ПолучитьТаблицуЗначенийУпакованныхВКороб(ПоследнийИспользованныйШККоробаПоПорядку, "Дойпак");
				СколькоУжеУпакованоПоШККоробу = ТаблицаЗначенийУпакованных.Количество();
				Если КоличествоВОдномКоробеВКарточкеНоменклатуры = СколькоУжеУпакованоПоШККоробу Тогда//если уже укомплектован этот короб, то получаем следующий 
					
					ФлагНайденного = Ложь;
					Для Каждого СтрокаТаблицаЗначенийКоробовПоНоменклатуре Из ТаблицаЗначенийКоробовПоНоменклатуре Цикл
						Если ФлагНайденного Тогда
							ПараметрыДляВводаКороба.ШККороба = СтрокаТаблицаЗначенийКоробовПоНоменклатуре.ШККороба;
							Прервать;
						КонецЕсли;
						Если СтрокаТаблицаЗначенийКоробовПоНоменклатуре.ШККороба = ПоследнийИспользованныйШККоробаПоПорядку Тогда
							ФлагНайденного = Истина;
						КонецЕсли;
					КонецЦикла;
					
					Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
						Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //на часть набора первым попасть не можем, таблица отсортирована
							Продолжить;
						ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Дойпак" Тогда
							ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
						КонецЕсли;
					КонецЦикла;
					ПараметрыДляВводаКороба.Тип = "Дойпак";
					ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
					ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
					
				Иначе
					
					Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
						Если СтрокаТаблицыЗначенийУпаковки.СобраноВКороб = Истина Тогда //на часть набора первым попасть не можем, таблица отсортирована
							Продолжить;
						ИначеЕсли СтрокаТаблицыЗначенийУпаковки.Тип = "Дойпак" Тогда
							ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
						КонецЕсли;
					КонецЦикла;
					ПараметрыДляВводаКороба.Тип = "Дойпак";
					ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
					ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
					Если КоличествоВОдномКоробеВКарточкеНоменклатуры - СколькоУжеУпакованоПоШККоробу = 1 Тогда//печатаем ШК короба, если не хватает всего одного дойпака
						ПараметрыДляВводаКороба.ВыводитьПечатьШККороба = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		//Нужно получить первый шк короба, передать Наборы массив или Дойпаки массив
		//ШККоробаПервый Передали
		ПараметрыДляВводаКороба.ШККороба = ТаблицаЗначенийКоробовПоНоменклатуре[0].ШККороба;
		
		//определяем массив какой передавать - массив наборов КМ или массив дойпаков КМ
		Если ТаблицаЗначенийУпаковки[0].Тип = "Набор" Тогда
			
			ПараметрыДляВводаКороба.Тип = "Набор";
			ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура; 
			ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
			//если набор - передаем массив наборов
			Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
				//Нужно найти наборы
				Если СтрокаТаблицыЗначенийУпаковки.Тип = "ЧастьНабора" Тогда//если ЧастьНабора, идем к следующему
					Продолжить;
				Иначе//добавляем в Массив
					ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТаблицаЗначенийУпаковки[0].Тип = "Дойпак" Тогда //если дойпак - у нас нужно просто добавить все КМ
			
			Для Каждого СтрокаТаблицыЗначенийУпаковки Из ТаблицаЗначенийУпаковки Цикл
				ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Добавить(СтрокаТаблицыЗначенийУпаковки.КодМаркировки);
			КонецЦикла;
			ПараметрыДляВводаКороба.Тип = "Дойпак";
			ПараметрыДляВводаКороба.НоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура;
			ПараметрыДляВводаКороба.ШтрихкодНоменклатураСборки = ТаблицаЗначенийУпаковки[0].Номенклатура.Штрихкод;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Если у нас остался один - печатаем ШК
	Если ПараметрыДляВводаКороба.МассивКодовМаркировкиНеУпакованных.Количество() = 1 Тогда
		ПараметрыДляВводаКороба.ВыводитьПечатьШККороба = Истина;
	КонецЕсли; 
	
	//но если у нас несколько дойпаков передается и у нас в короб влезает только один - тоже печатаем
	
	//передаем структуру
	Возврат ПараметрыДляВводаКороба;
	
КонецФункции

