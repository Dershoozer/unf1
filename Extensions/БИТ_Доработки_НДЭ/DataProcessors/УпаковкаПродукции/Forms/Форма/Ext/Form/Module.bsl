&НаСервере
Функция СгенерироватьШККоробовОЗОН(НужноКоробов)
	
	//сначала находим последний сгенерированный
	//префикс = ZN_ + числовое значение = 10 последних символов
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(СОКРЛ(ПРАВ(ДанныеПоКоробам.ШККороба, 10)) КАК СТРОКА(10)) КАК ШККороба
	               |ИЗ
	               |	РегистрСведений.ДанныеПоКоробам КАК ДанныеПоКоробам
	               |ГДЕ
	               |	ЛЕВ(ДанныеПоКоробам.ШККороба, 3) ПОДОБНО &Префикс + ""%""
	               |	И ЕСТЬNULL(ДанныеПоКоробам.ШККороба, """") <> """"";
	Запрос.УстановитьПараметр("Префикс", "ZN_");

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПоследнийНомерШККороба = 0;
	Если Выборка.Количество() = 0 Тогда//у нас нет еще ШКОзона, создаем первые
		ПоследнийНомерШККороба = 0;
	Иначе//у нас есть созданные, начинаем поиск максимального 
		ТаблицаЗначенийЧиселШККоробов = Новый ТаблицаЗначений;
		ТаблицаЗначенийЧиселШККоробов.Колонки.Добавить("ШККороба");
		Пока Выборка.Следующий() Цикл
			Стр = ТаблицаЗначенийЧиселШККоробов.Добавить();
			Стр.ШККороба = (ЧИСЛО(Выборка.ШККороба));
		КонецЦикла;
		ТаблицаЗначенийЧиселШККоробов.Сортировать("ШККороба Убыв");
		ПоследнийНомерШККороба = ТаблицаЗначенийЧиселШККоробов[0].ШККороба;
	КонецЕсли;
	
	//теперь добавляем следующие номера
	МассивНовыхШК = Новый Массив;
	Номер = 1;
	Пока Номер <> НужноКоробов+1 Цикл
		МассивНовыхШК.Добавить(Строка(ПоследнийНомерШККороба + Номер));
		Номер = Номер+1;
	КонецЦикла;
	
	//теперь каждый номер нужно преобразовать в строку с нулями, всего длина = 10
	ПреобразованныйМассив = Новый Массив;
	Для Каждого НовыйШК Из МассивНовыхШК Цикл
		НеобходимаяДлина = 10 - СтрДлина(НовыйШК);
		СтрокаНулей = Лев("0000000000", НеобходимаяДлина);
		НовыйНомер = СтрокаНулей + СтрЗаменить(НовыйШК, " ", "");
		
		ПреобразованныйМассив.Добавить("ZN_" + НовыйНомер);
	КонецЦикла;
	
	Возврат ПреобразованныйМассив;
	
КонецФункции

