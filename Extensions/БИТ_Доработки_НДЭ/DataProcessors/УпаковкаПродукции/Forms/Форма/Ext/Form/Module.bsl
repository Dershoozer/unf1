&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//ЭтаФорма.Окно.Состояние = ВариантСостоянияОкна.Максимизированное;
	//ВариантСпособаОтображенияОкна = ЭтаФорма.ВариантСпособаОтображенияОкна.Максимизированное;
	
	РазрешеноЗакрытиеФормы = Ложь;
	
	Если Параметры.Свойство("ПроизводствоОснование") Тогда
		Объект.ПроизводствоСсылка = Параметры.ПроизводствоОснование;
		Объект.ЗаказПокупателяСсылка = Объект.ПроизводствоСсылка.ЗаказПокупателя;
		Объект.Контрагент = Объект.ЗаказПокупателяСсылка.Контрагент;
		Если Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("РВБ ООО") Тогда
			Объект.ИспользуемыйСклад = 2;
		ИначеЕсли Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("ИНТЕРНЕТ РЕШЕНИЯ ООО") Тогда 
			Объект.ИспользуемыйСклад = 1;
		Иначе
			ВызватьИсключение("Неверный контрагент в заказе покупателя, необходимо указать РВБ ООО или ИНТЕРНЕТ РЕШЕНИЯ ООО");
		КонецЕсли;
	Иначе
		ВызватьИсключение("Нет основания документа производства или заказа покупателя!");
	КонецЕсли;
	
    // Получаем переданную строку ТЧ
    Если Параметры.Свойство("ПродукцияТЧ") И Параметры.Свойство("БИТ_КлючСтроки") Тогда
        ТекущаяСтрокаТЧ = Параметры.ПродукцияТЧ.НайтиСтроки(Новый Структура("БИТ_КлючСтроки",Параметры.БИТ_КлючСтроки))[0];
		Объект.КоличествоНоменклатуры = ТекущаяСтрокаТЧ.Количество;
		Объект.БИТ_КлючСтроки = Параметры.БИТ_КлючСтроки;
		Если ТекущаяСтрокаТЧ.Сотрудник = Неопределено ИЛИ ТекущаяСтрокаТЧ.Сотрудник = Справочники.Сотрудники.ПустаяСсылка() Тогда
			ВызватьИсключение("Не заполнен сотрудник по текущей строке!");
		Иначе
			Объект.ОтветственныйСотрудник = ТекущаяСтрокаТЧ.Сотрудник;
		КонецЕсли;
		Если ТекущаяСтрокаТЧ.ЗонаУпаковки = Неопределено ИЛИ ТекущаяСтрокаТЧ.ЗонаУпаковки = Справочники.Сотрудники.ПустаяСсылка() Тогда
			ВызватьИсключение("Не заполнена ЗонаУпаковки по текущей строке!");
		Иначе
			Объект.ОтветственнаяЗона = ТекущаяСтрокаТЧ.ЗонаУпаковки;
		КонецЕсли;
	Иначе
		ВызватьИсключение("Не выбрана текущая строка!");
    КонецЕсли;
    
    // Сохраняем данные строки (используем правильные имена реквизитов из формы)
    Объект.ТекущаяНоменклатура = ТекущаяСтрокаТЧ.Номенклатура;
	
	//Что имеем!!!!!!!!!!!!!!
	//Объект.ПроизводствоСсылка - сам документ производства
	//Объект.ЗаказПокупателяСсылка - сам документ заказа покупателя 
	//Объект.Контрагент - значение контрагента из заказа покупателя(для склада)
	//Объект.ТекущаяСтрокаТЧ - текущая строка ТЧ производства
	//Объект.ТекущаяНоменклатура - текущая номенклатура в текущей строке
	//Объект.ЭтапСборки : 0 - нет записей в регистре, "начать упаковку"
	//                    1 - есть записи в регистре, но неизвестно отсканированные "продолжить упаковку"
	//                    2 - все отсканированы, "упаковка завершена"
	//                    3 - есть отсканенные в короба, "продолжить упаковку короба"
	//                    4 - все в короба отсканены, "упаковка в короба завершена"
	Объект.ЭтапСборки = 0;
	ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Параметры.БИТ_КлючСтроки);
	Если ТаблицаЗначенийУпаковки.Количество() = 0 Тогда
		#Область НачальнаяЗаписьВРегистр
		////////////////////////////////////////////////////////////////
		//НАЧАЛЬНАЯ СТАДИЯ, запись в регистр значений кодов маркировки//
		///////////////////////////////////////////////////////////////
		ЭтоНаборНоменклатуры = НоменклатураЭтоНабор(Объект.ТекущаяНоменклатура);
		Если ЭтоНаборНоменклатуры = Неопределено Тогда
			ВызватьИсключение("Не найден штрихкод номенклатуры или ОписаниеGTINИС!");
		КонецЕсли;
		Если ЭтоНаборНоменклатуры Тогда
			//Работаем с текущей номенклатурой набором
			НоменклатураGTINНабора = ПолучитьGTINНоменклатуры(Объект.ТекущаяНоменклатура);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПулКодовМаркировкиСУЗ.Номенклатура КАК Номенклатура,
			|	ПулКодовМаркировкиСУЗ.GTIN КАК GTIN,
			|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
			|	ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки КАК ШтрихкодУпаковки
			|ИЗ
			|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
			|ГДЕ
			|	ПулКодовМаркировкиСУЗ.ДокументОснование = &ЗаказНаПроизводство
			|	И ПулКодовМаркировкиСУЗ.GTIN = &НоменклатураGTINНабора";

			Запрос.УстановитьПараметр("ЗаказНаПроизводство", Объект.ПроизводствоСсылка.ЗаказНаПроизводство);
			Запрос.УстановитьПараметр("НоменклатураGTINНабора", НоменклатураGTINНабора);
			Результат = Запрос.Выполнить();
			ТаблицаКодовНаборов = Результат.Выгрузить();
			ТаблицаКодовНаборов.Колонки.Добавить("НомерНабора");
			ТаблицаКодовНаборов.Колонки.Добавить("Тип");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.Тип = "Набор";
			КонецЦикла;
			НомерНабораВТаблице = 1;
			Для Каждого СтрокаТаблицыНаборов Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицыНаборов.НомерНабора = НомерНабораВТаблице;
				НомерНабораВТаблице = НомерНабораВТаблице + 1;
			КонецЦикла;
			ИндексСтроки = 0;
			Пока ИндексСтроки <> НомерНабораВТаблице-1 Цикл
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПулКодовМаркировкиСУЗ.Номенклатура КАК Номенклатура,
				|	ПулКодовМаркировкиСУЗ.GTIN КАК GTIN,
				|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
				|	ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки КАК ШтрихкодУпаковки
				|ИЗ
				|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
				|ГДЕ
				|	ПулКодовМаркировкиСУЗ.ДокументОснование = &ЗаказНаПроизводство
				|	И ПулКодовМаркировкиСУЗ.GTIN <> &НоменклатураGTINНабора
				|	И ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки = &ШтрихкодУпаковки";

				Запрос.УстановитьПараметр("ЗаказНаПроизводство", Объект.ПроизводствоСсылка.ЗаказНаПроизводство);
				Запрос.УстановитьПараметр("НоменклатураGTINНабора", НоменклатураGTINНабора);
				Запрос.УстановитьПараметр("ШтрихкодУпаковки", ТаблицаКодовНаборов[ИндексСтроки].ШтрихкодУпаковки);
				Результат = Запрос.Выполнить();
				ТаблицаКодовТоваровУНабора = Результат.Выгрузить();
				Для Каждого СтрокаТаблицыКодовТоваровУНабора Из ТаблицаКодовТоваровУНабора Цикл 
					НоваяСтрока = ТаблицаКодовНаборов.Добавить();
					НоваяСтрока.Номенклатура = СтрокаТаблицыКодовТоваровУНабора.Номенклатура; 
					НоваяСтрока.GTIN = СтрокаТаблицыКодовТоваровУНабора.GTIN;
					НоваяСтрока.КодМаркировки = СтрокаТаблицыКодовТоваровУНабора.КодМаркировки;
					НоваяСтрока.ШтрихкодУпаковки = СтрокаТаблицыКодовТоваровУНабора.ШтрихкодУпаковки;
					НоваяСтрока.НомерНабора = ТаблицаКодовНаборов[ИндексСтроки].НомерНабора;
					НоваяСтрока.Тип = "ЧастьНабора";
				КонецЦикла;
				ИндексСтроки = ИндексСтроки + 1;
			КонецЦикла;
			
			ТаблицаКодовНаборов.Сортировать("НомерНабора");
			ТаблицаКодовНаборов.Колонки.Добавить("Отсканировано"); 
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.Отсканировано = Ложь;
			КонецЦикла;
			ТаблицаКодовНаборов.Колонки.Добавить("ДокументОснование");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.ДокументОснование = Объект.ПроизводствоСсылка;
			КонецЦикла;
			ТаблицаКодовНаборов.Колонки.Добавить("НомерСтрокиВДокументеОсновании");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.НомерСтрокиВДокументеОсновании = Параметры.БИТ_КлючСтроки;
			КонецЦикла;
			ТаблицаКодовНаборов.Колонки.Добавить("ИндексСтроки");
			ИндексСтроки_Бит = 0;
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.ИндексСтроки = ИндексСтроки_Бит;
				ИндексСтроки_Бит = ИндексСтроки_Бит + 1;
			КонецЦикла;
			ТаблицаКодовНаборов.Колонки.Добавить("Период");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНаборов Цикл
				СтрокаТаблицы.Период = ТекущаяДата();
			КонецЦикла;
			ЗаписатьВРегистрСведенийУпаковкаПродукцииКодыМаркировки(ТаблицаКодовНаборов);
				
				
			//ТаблицаКодовНаборов = ЗаполнитьНаборыКодамиМаркировки(ТаблицаКодовНаборов);
			
		Иначе
			//Работаем с текущей номенклатурой обычной
			НоменклатураGTIN = ПолучитьGTINНоменклатуры(Объект.ТекущаяНоменклатура);
			/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПулКодовМаркировкиСУЗ.Номенклатура КАК Номенклатура,
			|	ПулКодовМаркировкиСУЗ.GTIN КАК GTIN,
			|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
			|	ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки КАК ШтрихкодУпаковки
			|ИЗ
			|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
			|ГДЕ
			|	ПулКодовМаркировкиСУЗ.ДокументОснование = &ЗаказНаПроизводство
			|	И ПулКодовМаркировкиСУЗ.GTIN = &НоменклатураGTIN
			|	И ЕСТЬNULL(ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки.ЗначениеШтрихкода, """") = """"";  //чем отличается часть набора от дойпака
			
			//Запрос.Текст = 
			//"ВЫБРАТЬ
			//|	ПулКодовМаркировкиСУЗ.Номенклатура КАК Номенклатура,
			//|	ПулКодовМаркировкиСУЗ.GTIN КАК GTIN,
			//|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
			//|	ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки КАК ШтрихкодУпаковки
			//|ИЗ
			//|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
			//|ГДЕ
			//|	ПулКодовМаркировкиСУЗ.ДокументОснование = &ЗаказНаПроизводство
			//|	И ПулКодовМаркировкиСУЗ.GTIN = &НоменклатураGTIN";
			
			Запрос.УстановитьПараметр("ЗаказНаПроизводство", Объект.ПроизводствоСсылка.ЗаказНаПроизводство);
			Запрос.УстановитьПараметр("НоменклатураGTIN", НоменклатураGTIN);
			Результат = Запрос.Выполнить();
			ТаблицаКодовНоменклатуры = Результат.Выгрузить();
			ТаблицаКодовНоменклатуры.Колонки.Добавить("НомерНабора");
			ТаблицаКодовНоменклатуры.Колонки.Добавить("Тип");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.Тип = "Дойпак";
				СтрокаТаблицы.НомерНабора = 0;
			КонецЦикла;
			
			ТаблицаКодовНоменклатуры.Колонки.Добавить("Отсканировано"); 
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.Отсканировано = Ложь;
			КонецЦикла;
			ТаблицаКодовНоменклатуры.Колонки.Добавить("ДокументОснование");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.ДокументОснование = Объект.ПроизводствоСсылка;
			КонецЦикла;
			ТаблицаКодовНоменклатуры.Колонки.Добавить("НомерСтрокиВДокументеОсновании");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.НомерСтрокиВДокументеОсновании = Параметры.БИТ_КлючСтроки;
			КонецЦикла;
			ТаблицаКодовНоменклатуры.Колонки.Добавить("ИндексСтроки");
			ИндексСтроки_Бит = 0;
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.ИндексСтроки = ИндексСтроки_Бит;
				ИндексСтроки_Бит = ИндексСтроки_Бит + 1;
			КонецЦикла;
			ТаблицаКодовНоменклатуры.Сортировать("ИндексСтроки");
			ТаблицаКодовНоменклатуры.Колонки.Добавить("Период");
			Для Каждого СтрокаТаблицы Из ТаблицаКодовНоменклатуры Цикл
				СтрокаТаблицы.Период = ТекущаяДата();
			КонецЦикла;
			ЗаписатьВРегистрСведенийУпаковкаПродукцииКодыМаркировки(ТаблицаКодовНоменклатуры);
			//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			
		КонецЕсли;
		Объект.ЭтапСборки = 1;
		#КонецОбласти
		
		Если Объект.ИспользуемыйСклад = 1 Тогда
			СоздатьШтрихкодыДляКоробовОЗОН();
		КонецЕсли;
		
		ТаблицаМонопаллетов = ПолучитьТаблицуВсехМоноПаллетовПоДокументу();
		Если ТаблицаМонопаллетов <> Неопределено Тогда
			Если Объект.ИспользуемыйСклад = 2 И ТаблицаМонопаллетов.Количество() > 0 Тогда
				СоздатьШтрихкодыДляКоробовВБПриМонопаллете();
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если ВсяУпаковкаЗавершена() Тогда
			Элементы.НачатьУпаковку.Заголовок = "Упаковка завершена";
			Объект.ЭтапСборки = 2;
			Если НачатаУпаковкаВКороба() Тогда
				Объект.ЭтапСборки = 3;
				Элементы.НачатьУпаковку.Заголовок = "Начать/Продолжить упаковку в короба";
				Элементы.ПоказатьДеревоЗначений.Видимость = Истина;
				Элементы.ПоказатьДеревоЗначений.Доступность = Истина;
				Если ВсяУпаковкаВКоробаЗавершена() Тогда
					Объект.ЭтапСборки = 4;
					Элементы.НачатьУпаковку.Заголовок = "Упаковка в короба завершена";
				КонецЕсли;
			Иначе
				Элементы.ПоказатьДеревоЗначений.Видимость = Ложь;
				Элементы.ПоказатьДеревоЗначений.Доступность = Ложь;
			КонецЕсли;
		Иначе
			Элементы.ПоказатьДеревоЗначений.Видимость = Ложь;
			Элементы.ПоказатьДеревоЗначений.Доступность = Ложь;
			Элементы.НачатьУпаковку.Заголовок = "Начать/Продолжить упаковку";
			Объект.ЭтапСборки = 1;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если НЕ ЗавершениеРаботы И НЕ РазрешеноЗакрытиеФормы Тогда
		Сообщить("Разрешено закрытие формы только через кнопку ""Возврат к документу""");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуВсехМоноПаллетовПоДокументу()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыМонопаллетов.Период КАК Период,
	|	ШтрихкодыМонопаллетов.ДокументОснование КАК ДокументОснование,
	|	ШтрихкодыМонопаллетов.ШтрихкодМонопаллета КАК ШтрихкодМонопаллета,
	|	ШтрихкодыМонопаллетов.НоменклатураДляМонопаллета КАК НоменклатураДляМонопаллета,
	|	ШтрихкодыМонопаллетов.БаркодТовара КАК БаркодТовара,
	|	ШтрихкодыМонопаллетов.ПорядковыйНомерМонопаллета КАК ПорядковыйНомерМонопаллета,
	|	ШтрихкодыМонопаллетов.ШтрихкодПаллета КАК ШтрихкодПаллета
	|ИЗ
	|	РегистрСведений.ШтрихкодыМонопаллетов КАК ШтрихкодыМонопаллетов
	|ГДЕ
	|	ШтрихкодыМонопаллетов.ДокументОснование = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШтрихкодМонопаллета,
	|	ПорядковыйНомерМонопаллета";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ЗаказПокупателяСсылка);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		// Логирование ошибки (опционально)
		// ЗаписьЖурналаРегистрации("Ошибка запроса паллет", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	//Есть ли данные в результате
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Выгрузка результата с обработкой ошибок
	Попытка
		ТаблицаМонопаллетов = РезультатЗапроса.Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ТаблицаМонопаллетов;
	
КонецФункции

&НаСервере
Процедура СоздатьШтрихкодыДляКоробовВБПриМонопаллете();
	СсылкаЗаказПокупателя = Объект.ЗаказПокупателяСсылка;
	Номенклатура = Объект.ТекущаяНоменклатура;
	БаркодТовара = Номенклатура.Штрихкод;
	
	//необходимо понять сколько коробов генерировать
	ОбщееКоличествоНоменклатуры = Объект.КоличествоНоменклатуры;
	КоличествоВОдномКоробеВКарточкеНоменклатуры = ПолучитьЗначениеДопРеквизитаКороб(Номенклатура);
	Если КоличествоВОдномКоробеВКарточкеНоменклатуры = Неопределено ИЛИ КоличествоВОдномКоробеВКарточкеНоменклатуры = 0 Тогда
		ВызватьИсключение("Не задано кол-во коробов в карточке номенклатуры!");
	КонецЕсли;
	НужноКоробов = Цел(ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры);
	ДробнаяЧасть = ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры;
	Если  НужноКоробов <> ДробнаяЧасть Тогда
		НужноКоробов = НужноКоробов + 1;
	КонецЕсли;
	
	//генерируем новое количество
	МассивШККоробовВБ = СгенерироватьШККоробовВБПриМонопаллетах(НужноКоробов);
	
	//Формируем таблицу значений для записи в регистр
	ТаблицаЗначенийШККоробов = Новый ТаблицаЗначений;
	ТаблицаЗначенийШККоробов.Колонки.Добавить("Период");
	ТаблицаЗначенийШККоробов.Колонки.Добавить("ДокументОснование");
	ТаблицаЗначенийШККоробов.Колонки.Добавить("ШККороба");
	ТаблицаЗначенийШККоробов.Колонки.Добавить("ПорядковыйНомерКороба");
	ТаблицаЗначенийШККоробов.Колонки.Добавить("БаркодТовара");
	ТаблицаЗначенийШККоробов.Колонки.Добавить("Номенклатура");
	Номер = 1;
	Пока Номер <> НужноКоробов+1 Цикл
		Стр = ТаблицаЗначенийШККоробов.Добавить();
		Стр.Период = ТекущаяДата();
		Стр.ДокументОснование = СсылкаЗаказПокупателя;
		Стр.ШККороба = МассивШККоробовВБ[Номер-1];
		Стр.ПорядковыйНомерКороба = Номер;
		Стр.БаркодТовара = БаркодТовара;
		Стр.Номенклатура = Номенклатура;
		Номер = Номер+1;
	КонецЦикла;
	
	//теперь записываем ТаблицаЗначенийШККоробов
	
	//Получаем значения для отбора из первой строки
	ДокументОснование = ТаблицаЗначенийШККоробов[0].ДокументОснование;
	//ШККороба = ТаблицаЗначенийШККоробов[0].ШККороба;
	
	// Пакетная запись в регистр
	НаборЗаписей = РегистрыСведений.ДанныеПоКоробам.СоздатьНаборЗаписей();
	
	//Пакетная запись в регистр (удаляем старые записи по этому документу, записываем новые)
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);
	//НаборЗаписей.Отбор.ШККороба.Установить(ШККороба);
	
	НаборЗаписей.Прочитать();      // Читаем старые записи по этому отбору
	НаборЗаписей.Загрузить(ТаблицаЗначенийШККоробов);  // Загружаем новые данные
	НаборЗаписей.Записать(Ложь); // Истина = замещать старые записи новыми
	
	Сообщить("Данные успешно записаны в регистр ДанныеПоКоробам. Записей: " + ТаблицаЗначенийШККоробов.Количество() + ". Можно приступать к работе!");
	
	
