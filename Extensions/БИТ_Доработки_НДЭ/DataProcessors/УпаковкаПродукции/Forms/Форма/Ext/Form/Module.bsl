	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование = &ДокументОснование
	|	И УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании = &НомерСтрокиВДокументеОсновании
	|	И УпаковкаПродукцииКодыМаркировки.Отсканировано = ИСТИНА";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ПроизводствоСсылка);
	Запрос.УстановитьПараметр("НомерСтрокиВДокументеОсновании", Объект.БИТ_КлючСтроки);
	
	Результат = Запрос.Выполнить();
	ТаблицаЗначений = Результат.Выгрузить();
	
	Если ТаблицаЗначений.Количество() < 1 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТаблицаЗначений[0].Тип = "Набор" ИЛИ ТаблицаЗначений[0].Тип = "ЧастьНабора" Тогда
		//ТаблицаЗначений.Свернуть("Тип");
