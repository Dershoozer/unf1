				ОтсканированныеКоличество = ОтсканированныеКоличество +1;
			КонецЕсли;
		КонецЦикла;
		Возврат ОтсканированныеКоличество;
	КонецЕсли;
	
	Возврат ТаблицаЗначений.Количество();
КонецФункции

&НаКлиенте
Асинх Процедура ПослеВводаКодаМаркировкиДляКороба(Результат, ПараметрыПослеУдачногоВвода) Экспорт
	/////////////////////////////////////////////////////////
	Если Результат <> Неопределено И Результат <> "" Тогда
		//обновляем РС
		ОбновитьСтатусПоКодуМаркировкиПоКоробам(Результат, ПараметрыПослеУдачногоВвода.ШККороба);
		
		////озвучиваем количество номер сколько уже упаковано в короб
		КоличествоУпакованных = ПолучитьКоличествоУпакованныхВКороб(ПараметрыПослеУдачногоВвода.ШККороба);
		КоличествоВОдномКоробеВКарточкеНоменклатуры = ПолучитьЗначениеДопРеквизитаКороб(Объект.ТекущаяНоменклатура);
		//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб");
		СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб";
		//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(КоличествоВОдномКоробеВКарточкеНоменклатуры) + " собрано в короб");
		
		Если ПараметрыПослеУдачногоВвода.ВыводитьПечатьШККороба Тогда//если выводилась печать ШК короба, то это последний добавленный в короб и короб упакован
			СоздатьЗаписьВРСУпакованныеКороба(ПараметрыПослеУдачногоВвода.ШККороба);
			
			ОзвучитьТекст("Отгрузочный короб собран");
			
			СтрокаВопроса = "Короб с ШТРИХКОДОМ: " +Строка(ПараметрыПослеУдачногоВвода.ШККороба) + " полностью упакован, перейти к следующему?";
			Ответ = Ждать ВопросАсинх(СтрокаВопроса, РежимДиалогаВопрос.ДаНет);
			
			// Этот код выполнится ТОЛЬКО ПОСЛЕ ТОГО, как пользователь ответит на вопрос.
			Если Ответ = КодВозвратаДиалога.Да Тогда
			Сообщить("Начата упаковка следующего короба!");
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		//проверяем на завершение
		Если ВсяУпаковкаВКоробаЗавершена() Тогда
			Элементы.НачатьУпаковку.Заголовок = "Упаковка в короба завершена";
			ОзвучитьТекст("Упаковка строки полностью завершена");
			Сообщить("Упаковка в короба полностью завершена, все КМ отсканированы");
			Возврат;
		КонецЕсли;
		
		
		//получаем следующие коды маркировки
		ПараметрыСтруктура = ПолучитьКодыМаркировкиДляКороба();
		Если ПараметрыСтруктура = Неопределено Тогда
			Сообщить("Ошибка ПриПолученииКодовМаркировки для коробов");
			Возврат;
		КонецЕсли;
		ПараметрыСтруктура.Вставить("ИспользуемыйСклад", Объект.ИспользуемыйСклад);
		ПараметрыСтруктура.Вставить("СтрокаНумерацииУпакованных", СтрокаНумерацииУпакованных);
		
		
		ПараметрыПослеУдачногоВвода = Новый Структура;
		ПараметрыПослеУдачногоВвода.Вставить("ШККороба",ПараметрыСтруктура.ШККороба);
		ПараметрыПослеУдачногоВвода.Вставить("ВыводитьПечатьШККороба", ПараметрыСтруктура.ВыводитьПечатьШККороба);
		//дальше запускаем окно, пока не нажмется отмена или вся упаковка не завершится
		Оповещение = Новый ОписаниеОповещения("ПослеВводаКодаМаркировкиДляКороба", ЭтотОбъект, ПараметрыПослеУдачногоВвода);
		ОткрытьФорму("Обработка.УпаковкаПродукции.Форма.ВводКороба", ПараметрыСтруктура, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// Пользователь нажал Отмена или закрыл диалог
		Сообщить("Упаковка в короба отменена");
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеУпаковкиВопросЗавершен(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		// Пользователь нажал "Да"
		НачатьИлиПродолжитьУпаковкуВКороба();
		Возврат;
	Иначе
		// Пользователь нажал "Нет"
		Сообщить("Упаковка в короба отменена");
		Возврат;//прерываем
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусПоКодуМаркировки(КодМаркировки)
	
	Если КодМаркировки = "" Или КодМаркировки = Неопределено Тогда
		Сообщить("Ошибка: не указан код маркировки");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки КАК ИндексСтроки,
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование КАК ДокументОснование,
	|	УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании КАК НомерСтрокиВДокументеОсновании
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.КодМаркировки = &КодМаркировки";
	
	Запрос.УстановитьПараметр("КодМаркировки", КодМаркировки);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	// 2. Обновляем найденные записи через набор записей
	Если Выборка.Следующий() Тогда
		НаборЗаписей = РегистрыСведений.УпаковкаПродукцииКодыМаркировки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИндексСтроки.Установить(Выборка.ИндексСтроки);
		НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		НаборЗаписей.Отбор.НомерСтрокиВДокументеОсновании.Установить(Выборка.НомерСтрокиВДокументеОсновании);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.Отсканировано = Истина;
			Запись.ДатаУпаковки = ТекущаяДата();
			Запись.ЗонаУпаковка = Объект.ОтветственнаяЗона;
			Запись.ОтветственныйЗаУпаковкуСотрудник = Объект.ОтветственныйСотрудник;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		Сообщить("Статус обновлен для кода: " + КодМаркировки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусПоКодуМаркировкиПоКоробам(КодМаркировки, ШККороба)
	
	Если КодМаркировки = "" Или КодМаркировки = Неопределено Тогда
		Сообщить("Ошибка: не указан код маркировки");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки КАК ИндексСтроки,
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование КАК ДокументОснование,
	|	УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании КАК НомерСтрокиВДокументеОсновании,
	|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип,
	|	УпаковкаПродукцииКодыМаркировки.НомерНабора КАК НомерНабора
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.КодМаркировки = &КодМаркировки";
	
	Запрос.УстановитьПараметр("КодМаркировки", КодМаркировки);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	// 2. Обновляем найденные записи через набор записей
	Если Выборка.Следующий() Тогда
		Если Выборка.Тип = "Набор" Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки КАК ИндексСтроки,
			|	УпаковкаПродукцииКодыМаркировки.ДокументОснование КАК ДокументОснование,
			|	УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании КАК НомерСтрокиВДокументеОсновании,
			|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип,
			|	УпаковкаПродукцииКодыМаркировки.НомерНабора КАК НомерНабора
			|ИЗ
			|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
			|ГДЕ
			|	УпаковкаПродукцииКодыМаркировки.ДокументОснование = &ДокументОснование
			|	И УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании = &НомерСтрокиВДокументеОсновании
			|	И УпаковкаПродукцииКодыМаркировки.НомерНабора = &НомерНабора";
			
			Запрос.УстановитьПараметр("ДокументОснование", Выборка.ДокументОснование);
			Запрос.УстановитьПараметр("НомерСтрокиВДокументеОсновании", Выборка.НомерСтрокиВДокументеОсновании);
			Запрос.УстановитьПараметр("НомерНабора", Выборка.НомерНабора);
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				НаборЗаписей = РегистрыСведений.УпаковкаПродукцииКодыМаркировки.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИндексСтроки.Установить(Выборка.ИндексСтроки);
				НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
				НаборЗаписей.Отбор.НомерСтрокиВДокументеОсновании.Установить(Выборка.НомерСтрокиВДокументеОсновании);
				НаборЗаписей.Прочитать();
				
				Для каждого Запись Из НаборЗаписей Цикл
					Запись.ШтрихкодКороба = ШККороба;
					Запись.СобраноВКороб = Истина;
					Запись.ДатаКороб = ТекущаяДата();
					Запись.ЗонаКороб = Объект.ОтветственнаяЗона;
					Запись.ОтветственныйЗаКоробСотрудник = Объект.ОтветственныйСотрудник;
				КонецЦикла;
				
				НаборЗаписей.Записать();
			КонецЦикла;
			Сообщить("Статус обновлен для кода: " + КодМаркировки);
		Иначе
			
			НаборЗаписей = РегистрыСведений.УпаковкаПродукцииКодыМаркировки.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИндексСтроки.Установить(Выборка.ИндексСтроки);
			НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
			НаборЗаписей.Отбор.НомерСтрокиВДокументеОсновании.Установить(Выборка.НомерСтрокиВДокументеОсновании);
			НаборЗаписей.Прочитать();
			
			Для каждого Запись Из НаборЗаписей Цикл
				Запись.ШтрихкодКороба = ШККороба;
				Запись.СобраноВКороб = Истина;
				Запись.ДатаКороб = ТекущаяДата();
				Запись.ЗонаКороб = Объект.ОтветственнаяЗона;
				Запись.ОтветственныйЗаКоробСотрудник = Объект.ОтветственныйСотрудник;
			КонецЦикла;
			
			НаборЗаписей.Записать();
			Сообщить("Статус обновлен для кода: " + КодМаркировки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

