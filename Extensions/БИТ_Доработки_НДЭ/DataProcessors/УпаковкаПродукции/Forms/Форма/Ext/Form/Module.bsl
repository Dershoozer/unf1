&НаСервере
Функция НоменклатураЭтоНабор(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|ОписаниеGTINИС.ВидУпаковки КАК ВидУпаковки
	|ИЗ
	|	РегистрСведений.ОписаниеGTINИС КАК ОписаниеGTINИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО ШтрихкодыНоменклатуры.Штрихкод = ОписаниеGTINИС.GTIN
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Количество() > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Выборка.Следующий() Тогда
		Если Выборка.ВидУпаковки = Перечисления.ВидыУпаковокИС.Набор Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьGTINНоменклатуры(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОписаниеGTINИС.GTIN КАК GTIN
	               |ИЗ
	               |	РегистрСведений.ОписаниеGTINИС КАК ОписаниеGTINИС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	               |		ПО (ШтрихкодыНоменклатуры.Штрихкод = ОписаниеGTINИС.GTIN)
	               |ГДЕ
	               |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Количество() > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Выборка.Следующий() Тогда
		Возврат Выборка.GTIN;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаписатьВРегистрСведенийУпаковкаПродукцииКодыМаркировки(ТаблицаКодов)
	// ---------------------------------------------------------------------------------
	// Запись данных в регистр сведений УпаковкаПродукцииКодыМаркировки
	// ---------------------------------------------------------------------------------
	// Проверка, что таблица не пустая
	Если ТаблицаКодов.Количество() = 0 Тогда
		Сообщить("Нет данных для записи в регистр");
		Возврат;
	КонецЕсли;
	
	// Получаем значения для отбора из первой строки
	ДокументОснование = ТаблицаКодов[0].ДокументОснование;
	НомерСтроки = ТаблицаКодов[0].НомерСтрокиВДокументеОсновании;
	
	// Пакетная запись в регистр
	НаборЗаписей = РегистрыСведений.УпаковкаПродукцииКодыМаркировки.СоздатьНаборЗаписей();
	
	//Пакетная запись в регистр (удаляем старые записи по этому документу, записываем новые)
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);
	НаборЗаписей.Отбор.НомерСтрокиВДокументеОсновании.Установить(НомерСтроки);
	
	НаборЗаписей.Прочитать();      // Читаем старые записи по этому отбору
	НаборЗаписей.Загрузить(ТаблицаКодов);  // Загружаем новые данные
	НаборЗаписей.Записать(Истина); // Истина = замещать старые записи новыми
	
	Сообщить("Данные успешно записаны в регистр УпаковкаПродукцииКодыМаркировки. Записей: " + ТаблицаКодов.Количество() + ". Можно приступать к работе!");
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаписьВРСУпакованныеКороба(ШККороба)
	// ---------------------------------------------------------------------------------
	// Запись данных в регистр сведений УпакованныеКороба
	// ---------------------------------------------------------------------------------
	
	// Получаем значения для отбора
	ДокументОснование = Объект.ПроизводствоСсылка;
	
	// Пакетная запись в регистр
	НаборЗаписей = РегистрыСведений.УпакованныеКороба.СоздатьНаборЗаписей();
	
	//Пакетная запись в регистр (удаляем старые записи по этому документу, записываем новые)
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);
	НаборЗаписей.Отбор.ШККороба.Установить(ШККороба);
	
	НаборЗаписей.Прочитать();      // Читаем старые записи по этому отбору
	
	//формируем таблицу значений для записи
	ТаблицаУпакованныхКоробов = Новый ТаблицаЗначений;
	ТаблицаУпакованныхКоробов.Колонки.Добавить("Период");
	ТаблицаУпакованныхКоробов.Колонки.Добавить("ДокументОснование");
	ТаблицаУпакованныхКоробов.Колонки.Добавить("ШККороба");
	ТекСтр = ТаблицаУпакованныхКоробов.Добавить();
	ТекСтр.Период = ТекущаяДата();
	ТекСтр.ДокументОснование = ДокументОснование;
	ТекСтр.ШККороба = ШККороба;
	
	
	НаборЗаписей.Загрузить(ТаблицаУпакованныхКоробов);  // Загружаем новые данные
	НаборЗаписей.Записать(Истина); // Истина = замещать старые записи новыми
	
	Сообщить("Данные успешно записаны в регистр УпакованныеКороба. Записей: " + ТаблицаУпакованныхКоробов.Количество() + ".");
	
КонецПроцедуры

&НаСервере
Функция ВсяУпаковкаЗавершена()
    ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки);
	Для каждого СтрокаТаблицы Из ТаблицаЗначенийУпаковки Цикл 
		Если Не СтрокаТаблицы.Отсканировано Тогда
			Возврат Ложь; 
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ВсяУпаковкаВКоробаЗавершена()
    ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки);
	Для каждого СтрокаТаблицы Из ТаблицаЗначенийУпаковки Цикл 
		Если Не СтрокаТаблицы.СобраноВКороб Тогда
			Возврат Ложь; 
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Функция НачатаУпаковкаВКороба()
    ТаблицаЗначенийУпаковки = ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(Объект.ПроизводствоСсылка, Объект.БИТ_КлючСтроки);
	Для каждого СтрокаТаблицы Из ТаблицаЗначенийУпаковки Цикл 
		Если СтрокаТаблицы.СобраноВКороб Тогда
			Возврат Истина; 
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПолучитьТаблицуЗначенийИзРегистраУпаковкаПродукцииКодыМаркировки(ДокументОснование, НомерСтрокиВДокументеОсновании)
	
	// Создаем запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки КАК ИндексСтроки,
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование КАК ДокументОснование,
	|	УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании КАК НомерСтрокиВДокументеОсновании,
	|	УпаковкаПродукцииКодыМаркировки.Номенклатура КАК Номенклатура,
	|	УпаковкаПродукцииКодыМаркировки.GTIN КАК GTIN,
	|	УпаковкаПродукцииКодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	УпаковкаПродукцииКодыМаркировки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	УпаковкаПродукцииКодыМаркировки.НомерНабора КАК НомерНабора,
	|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип,
	|	УпаковкаПродукцииКодыМаркировки.Отсканировано КАК Отсканировано,
	|	УпаковкаПродукцииКодыМаркировки.ШтрихкодКороба КАК ШтрихкодКороба,
	|	УпаковкаПродукцииКодыМаркировки.СобраноВКороб КАК СобраноВКороб
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование = &ДокументОснование
	|	И УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании = &НомерСтрокиВДокументеОсновании
	|
	|УПОРЯДОЧИТЬ ПО
	|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("НомерСтрокиВДокументеОсновании", НомерСтрокиВДокументеОсновании);
	
	Результат = Запрос.Выполнить();
	ТаблицаЗначений = Результат.Выгрузить();
	
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервере
Функция ПолучитьИзРегистраУпаковкаПродукцииКодыМаркировкиУнабора(ДокументОснование, НомерСтрокиВДокументеОсновании, НомерНабора)
	
	// Создаем запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.ИндексСтроки КАК ИндексСтроки,
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование КАК ДокументОснование,
	|	УпаковкаПродукцииКодыМаркировки.НомерСтрокиВДокументеОсновании КАК НомерСтрокиВДокументеОсновании,
	|	УпаковкаПродукцииКодыМаркировки.Номенклатура КАК Номенклатура,
	|	УпаковкаПродукцииКодыМаркировки.GTIN КАК GTIN,
	|	УпаковкаПродукцииКодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	УпаковкаПродукцииКодыМаркировки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	УпаковкаПродукцииКодыМаркировки.НомерНабора КАК НомерНабора,
	|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип,
	|	УпаковкаПродукцииКодыМаркировки.Отсканировано КАК Отсканировано
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.ДокументОснование = &ДокументОснование
