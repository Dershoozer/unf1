#Область ОбработчикиСобытийФормы

&НаСервере
Процедура БИТ_ДоработкаПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоматическаяАгрегация") Тогда // Возврат при получении формы для анализа.
		АвтоматическаяАгрегация = Параметры.АвтоматическаяАгрегация;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура БИТ_ДоработкаПриОткрытииПосле(Отказ)
	Если Не Отказ И АвтоматическаяАгрегация Тогда
		// Выполняем автоматическое добавление наборов
		АвтоматическиСформироватьУпаковкиИзНаборов();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область АвтоматическоеДобавлениеНаборов

&НаКлиенте
Процедура АвтоматическиСформироватьУпаковкиИзНаборов()
	
	// Проверяем, что режим формирования монотоварной упаковки включен
	// и произвольный состав упаковки разрешен
	//Если Не РежимФормированияМонотоварнойУпаковки Или Не ПроизвольныйСоставУпаковки Тогда
	//	Возврат;
	//КонецЕсли;
	
	// Счетчик сформированных упаковок
	ВсегоСформированоУпаковок = 0;
	
	// Запускаем цикл, пока есть наборы в остатках
	Пока Истина Цикл
		
		// Получаем список идентификаторов всех наборов в остатках
		МассивСтрок = ПолучитьНаборыИзОстатков();
		
		// Если наборов нет - выходим из цикла
		Если МассивСтрок.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Добавляем первый набор в состав упаковки
		МассивДляДобавления = Новый Массив;
		МассивДляДобавления.Добавить(МассивСтрок[0]);
		
		// Добавляем строку в состав упаковки
		ДобавитьСтрокиВСоставУпаковки(МассивДляДобавления);
		
		// Обновляем состояние элементов формы после добавления
		РассчитатьМаксимальноеКоличествоУпаковок();
		РассчитатьОстатокПоДокументу();
		УстановитьДоступностьЭлементовФормы();
		
		// Выполняем команду "СформироватьУпаковки"
		СформироватьУпаковки(Неопределено);
		
		// Увеличиваем счетчик сформированных упаковок
		ВсегоСформированоУпаковок = ВсегоСформированоУпаковок + 1;
		
		// Небольшая задержка для обновления интерфейса
		// Чтобы пользователь видел процесс
		//ОбработкаОжидания.Выполнить(1, Истина);
		
	КонецЦикла;
	
	// Если были сформированы упаковки, выводим итоговое сообщение
	Если ВсегоСформированоУпаковок > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Автоматически сформировано %1 упаковок из наборов'"), 
			ВсегоСформированоУпаковок));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНаборыИзОстатков()
	
	МассивСтрок = Новый Массив;
	
	// Проходим по всем строкам остатков продукции
	Для Каждого СтрокаОстатка Из ОстаткиПродукции Цикл
		
		// Проверяем, что это набор и есть свободный остаток
		// и агрегация доступна
		Если СтрокаОстатка.ЭтоНабор 
			И СтрокаОстатка.ЕстьСвободныйОстаток 
			И Не СтрокаОстатка.АгрегацияНедоступна 
			И СтрокаОстатка.Остаток > 0 Тогда
			
			// Добавляем идентификатор строки в массив
			МассивСтрок.Добавить(СтрокаОстатка.ПолучитьИдентификатор());
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

#КонецОбласти