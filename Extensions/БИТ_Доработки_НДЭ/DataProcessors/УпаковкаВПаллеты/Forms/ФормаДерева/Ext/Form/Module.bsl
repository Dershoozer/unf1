&НаСервере
Процедура ЗаполнитьДеревоДанными(СтрокаПаллет)
	
	//добавляем шк коробов в строкуПаллета
	МассивШККоробов = ПолучитьУпакованныеКоробаПоПаллету(ШКПаллета);
	Если МассивШККоробов = Неопределено Тогда
		Сообщить("По паллету " + ШКПаллета + " нет упакованных коробов");
		Возврат;
	КонецЕсли;
	
	Для Каждого ШККороба Из МассивШККоробов Цикл
		СтрокаКороб = СтрокаПаллет.Строки.Добавить();
		СтрокаКороб.Уровень = "-Короб";
		СтрокаКороб.ШтрихкодКороба = ШККороба.ШККороба;
		
		//теперь нужно понять набор или дойпак, получить все по регистру
		МассивКМНаборовИлиДойпаков = ПолучитьКМНаборовИлиДойпаков(ШККороба.ШККороба);
		Если МассивКМНаборовИлиДойпаков = Неопределено Тогда
			Сообщить("По коробу " + Строка(ШККороба.ШККороба) + " нет упакованных наборов или дойпаков");
			Возврат;
		КонецЕсли;
		
		//Добавляем в СтрокуКороба дойпаки
		Если МассивКМНаборовИлиДойпаков[0].Тип = "Дойпак" Тогда
			Для Каждого КМДойпаков Из МассивКМНаборовИлиДойпаков Цикл
				СтрокаДойпак = СтрокаКороб.Строки.Добавить();
				СтрокаДойпак.Уровень = "--Дойпак";
				СтрокаДойпак.КодМаркировки = КМДойпаков.КодМаркировки;
			КонецЦикла;
		КонецЕсли;
		
		//Добавляем в СтрокуКороба Наборы и части набора
		Если МассивКМНаборовИлиДойпаков[0].Тип = "Набор" Тогда
			Для Каждого КМНаборов Из МассивКМНаборовИлиДойпаков Цикл
				Если КМНаборов.Тип = "Набор" Тогда
					СтрокаДойпак = СтрокаКороб.Строки.Добавить();
					СтрокаДойпак.Уровень = "--Набор";
					СтрокаДойпак.КодМаркировки = КМНаборов.КодМаркировки;
					//получаем номер набора и добавляем части по нему
				ИначеЕсли КМНаборов.Тип = "ЧастьНабора" Тогда
					СтрокаЧастьНабора = СтрокаДойпак.Строки.Добавить();
					СтрокаЧастьНабора.Уровень = "---ЧастьНабора";
					СтрокаЧастьНабора.КодМаркировки = КМНаборов.КодМаркировки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУпакованныеКоробаПоПаллету(ШтрихкодПаллета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпакованныеКороба.ШККороба КАК ШККороба
	|ИЗ
	|	РегистрСведений.УпакованныеКороба КАК УпакованныеКороба
	|ГДЕ
	|	УпакованныеКороба.ШКПаллета = &ШКПаллета";
	
	Запрос.УстановитьПараметр("ШКПаллета", ШтрихкодПаллета);
	
	Результат = Запрос.Выполнить();
	ТаблицаЗначений = Результат.Выгрузить();
	Если ТаблицаЗначений.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервере
Функция ПолучитьКМНаборовИлиДойпаков(ШтрихкодКороба)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкаПродукцииКодыМаркировки.Тип КАК Тип,
	|	УпаковкаПродукцииКодыМаркировки.НомерНабора КАК НомерНабора,
	|	УпаковкаПродукцииКодыМаркировки.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	РегистрСведений.УпаковкаПродукцииКодыМаркировки КАК УпаковкаПродукцииКодыМаркировки
	|ГДЕ
	|	УпаковкаПродукцииКодыМаркировки.ШтрихкодКороба = &ШтрихкодКороба";
	
	Запрос.УстановитьПараметр("ШтрихкодКороба", ШтрихкодКороба);
	
	Результат = Запрос.Выполнить();
	ТаблицаЗначений = Результат.Выгрузить();
	Если ТаблицаЗначений.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТаблицаЗначений[0].Тип = "Дойпак" Тогда
		Возврат ТаблицаЗначений;
	КонецЕсли;
	ТаблицаЗначений.Сортировать("НомерНабора Возр, Тип Возр");
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаКлиенте
Процедура СвернутьДерево(Команда)
	
	Для Каждого СтрокаДерева Из ДеревоЗначенийПаллета.ПолучитьЭлементы() Цикл
		Элементы.ДеревоЗначенийПаллета.Свернуть(СтрокаДерева.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры
