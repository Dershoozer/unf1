

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РазрешеноЗакрытиеФормы = Ложь;
	Элементы.РаспечататьШтрихкодМонопаллета.Видимость = Ложь;
	
	Если Параметры.Свойство("ДокументОснование") Тогда
		Объект.ДокументОснование = Параметры.ДокументОснование;
		Объект.ЗаказПокупателяСсылка = Объект.ДокументОснование.ЗаказПокупателя;
		Объект.Контрагент = Объект.ЗаказПокупателяСсылка.Контрагент;
		Если Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("РВБ ООО") Тогда
			Объект.ИспользуемыйСклад = 2;
		ИначеЕсли Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("ИНТЕРНЕТ РЕШЕНИЯ ООО") Тогда 
			Объект.ИспользуемыйСклад = 1;
		Иначе
			ВызватьИсключение("Неверный контрагент в заказе покупателя, необходимо указать РВБ ООО или ИНТЕРНЕТ РЕШЕНИЯ ООО");
		КонецЕсли;
	Иначе
		ВызватьИсключение("Нет основания документа производства или заказа покупателя!");
	КонецЕсли; 
	
	Если Параметры.Свойство("ШКПаллета") Тогда
		ШКПаллета = Параметры.ШКПаллета;
	Иначе
		ВызватьИсключение("Нет штрихкода паллета!");
	КонецЕсли;
	Если Параметры.Свойство("ШтрихкодМонопаллета") Тогда
		ШтрихкодМонопаллета = Параметры.ШтрихкодМонопаллета;
	КонецЕсли;
	
	СформироватьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Устанавливаем обработчик ожидания, который сработает через 1 секунду
	WSHShell = Новый COMОбъект("WScript.Shell");
	WSHShell.SendKeys("% ");
	WSHShell.SendKeys("{DOWN}{DOWN}{DOWN}{DOWN}{ENTER}");
	ЭтаФорма.ОбновитьОтображениеДанных();
	//Элементы.ДеревоЗначенийПаллета.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПаллетаПриАктивизацииСтроки(Элемент)
	// Получаем данные текущей строки
	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	
	Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока = 0 И ЗначениеЗаполнено(ШтрихкодМонопаллета) Тогда//если выбрана строка и она первая(так как паллет под индексом 0
		// Получаем значение уровня из строки
		ЗначениеУровня = Элемент.ТекущиеДанные.Уровень;
		
		// Показываем кнопку, если уровень = "Паллет"
		Элементы.РаспечататьШтрихкодМонопаллета.Видимость = (ЗначениеУровня = "Паллет");
	Иначе
		Элементы.РаспечататьШтрихкодМонопаллета.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

