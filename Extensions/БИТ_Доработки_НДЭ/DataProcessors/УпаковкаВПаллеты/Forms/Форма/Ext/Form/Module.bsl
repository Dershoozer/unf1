Функция ПолучитьРазрешеннуюНоменклатуру(ШтрихкодМонопаллета, ШКПаллета)
	
	Если ШтрихкодМонопаллета = "" Или ШтрихкодМонопаллета = Неопределено Тогда
		Сообщить("Ошибка: не указан штрихкод Монопаллета");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыМонопаллетов.НоменклатураДляМонопаллета КАК НоменклатураДляМонопаллета,
	|	ШтрихкодыМонопаллетов.БаркодТовара КАК БаркодТовара
	|ИЗ
	|	РегистрСведений.ШтрихкодыМонопаллетов КАК ШтрихкодыМонопаллетов
	|ГДЕ
	|	ШтрихкодыМонопаллетов.ДокументОснование = &ДокументОснование
	|	И ШтрихкодыМонопаллетов.ШтрихкодМонопаллета = &ШтрихкодМонопаллета
	|	И ШтрихкодыМонопаллетов.ШтрихкодПаллета = &ШтрихкодПаллета";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ЗаказПокупателяСсылка);
	Запрос.УстановитьПараметр("ШтрихкодМонопаллета", ШтрихкодМонопаллета);
	Запрос.УстановитьПараметр("ШтрихкодПаллета", ШКПаллета);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		// Логирование ошибки (опционально)
		// ЗаписьЖурналаРегистрации("Ошибка запроса паллет", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	//Есть ли данные в результате
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Выгрузка результата с обработкой ошибок
	Попытка
		ТаблицаРазрешеннойНоменклатуры = РезультатЗапроса.Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ТаблицаРазрешеннойНоменклатуры;
	
КонецФункции

#Область Кнопки

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	// Перезагружаем данные из базы
	ОбновитьДанныеНаСервере();
	
	ТекстПодсказки = "Список обновлен";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеНаСервере()
	
	// Перезаполняем таблицу свежими данными
	Объект.Паллеты.Очистить();
	
	ТаблицаПаллетов = ПолучитьТаблицуВсехПаллетовПоДокументу();
	
	Если ТаблицаПаллетов = 0 Тогда
		ТекстПодсказки = "Ни одного паллета не создано по документу " + Строка(Объект.ДокументОснование.Наименование);
	Иначе
		//Выводим в ТЧ значения
		Для Каждого СтрокаТаблицы Из ТаблицаПаллетов Цикл
			НоваяСтрока = Объект.Паллеты.Добавить();
			НоваяСтрока.ШКПаллета = СтрокаТаблицы.ШтрихкодПаллета;
			НоваяСтрока.СколькоУпакованоКоробов = СтрокаТаблицы.СколькоУпаковано;
			НоваяСтрока.ПолностьюУпакован = СтрокаТаблицы.ПолностьюУпакован;
			НоваяСтрока.Вместимость = СтрокаТаблицы.Вместимость;
			НоваяСтрока.МоноПаллет = СтрокаТаблицы.МоноПаллет;
			НоваяСтрока.ШтрихкодМонопаллета = СтрокаТаблицы.ШтрихкодМонопаллета;
			НоваяСтрока.ОтветственнаяЗона = СтрокаТаблицы.ОтветственнаяЗона;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура НачатьСборкуВПаллет(Команда)
	
	// 1. Проверяем, что выделена хотя бы одна строка
	Если Не Объект.Паллеты.Количество() > 0 И Не Элементы.Паллеты.ТекущаяСтрока = Неопределено Тогда
		ТекстПодсказки = "Выделите строку паллета для начала работы.";
		Возврат;
	КонецЕсли;
	
	// 2. Получаем данные выделенной строки
	ТекущаяСтрока = Элементы.Паллеты.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.ПолностьюУпакован Тогда
		
		МассивСвободныхШКУпакованныхКоробов = Новый Массив;
		МассивСвободныхШКУпакованныхКоробов = ПолучитьШтрихкодыУпакованныхКоробов();
		
		Если МассивСвободныхШКУпакованныхКоробов = Неопределено Тогда
			ТекстПодсказки = "Еще не созданы упакованные короба";
			Возврат;
		КонецЕсли;
		
		//Нужно передавать упакованные короба только с нужной номенклатурой
		Если ТекущаяСтрока.МоноПаллет = Истина Тогда
			МассивСвободныхШКУпакованныхКоробов = ПолучитьШтрихкодыУпакованныхКоробовДляМонопаллета(ТекущаяСтрока.ШтрихкодМонопаллета, ТекущаяСтрока.ШКПаллета);
			Если МассивСвободныхШКУпакованныхКоробов = Неопределено Тогда
				ТекстПодсказки = "Еще не созданы упакованные короба для Монопаллета в которых есть Разрешенная номенклатура";
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДляВводаШККороба = Новый Структура;
		ПараметрыДляВводаШККороба.Вставить("МассивСвободныхШКУпакованныхКоробов", МассивСвободныхШКУпакованныхКоробов);
		ПараметрыДляВводаШККороба.Вставить("СколькоУжеУпакованоВПаллет", ТекущаяСтрока.СколькоУпакованоКоробов);
		ПараметрыДляВводаШККороба.Вставить("ИспользуемыйСклад", Объект.ИспользуемыйСклад);
		ПараметрыДляВводаШККороба.Вставить("ШКПаллета",ТекущаяСтрока.ШКПаллета);
		ПараметрыДляВводаШККороба.Вставить("СколькоВПоследнемПаллетеВместимость",Объект.СколькоВПоследнемПаллетеВместимость);
		ПараметрыДляВводаШККороба.Вставить("ДокументОснование",Объект.ДокументОснование);
		ПараметрыДляВводаШККороба.Вставить("ЗаказПокупателяСсылка",Объект.ЗаказПокупателяСсылка);
		ПараметрыДляВводаШККороба.Вставить("МоноПаллет",ТекущаяСтрока.МоноПаллет);
		ПараметрыДляВводаШККороба.Вставить("ШтрихкодМонопаллета",ТекущаяСтрока.ШтрихкодМонопаллета);
		ПараметрыДляВводаШККороба.Вставить("Вместимость",ТекущаяСтрока.Вместимость);
		
		ПараметрыПослеУдачногоВвода = Новый Структура;
		ПараметрыПослеУдачногоВвода.Вставить("ШКПаллета",ТекущаяСтрока.ШКПаллета);
		ПараметрыПослеУдачногоВвода.Вставить("СколькоУжеУпакованоВПаллет", ТекущаяСтрока.СколькоУпакованоКоробов);
		ПараметрыПослеУдачногоВвода.Вставить("МоноПаллет",ТекущаяСтрока.МоноПаллет);
		ПараметрыПослеУдачногоВвода.Вставить("ШтрихкодМонопаллета",ТекущаяСтрока.ШтрихкодМонопаллета);
		ПараметрыПослеУдачногоВвода.Вставить("Вместимость",ТекущаяСтрока.Вместимость);
		
		//озвучиваем количество номер сколько уже упаковано в короб
		КоличествоУпакованных = ТекущаяСтрока.СколькоУпакованоКоробов;
		ВместимостьПаллета = ПолучитьВместимостьПаллета(ТекущаяСтрока.ШКПаллета);
		//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет");
		СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет";
		//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет");
		ПараметрыДляВводаШККороба.Вставить("СтрокаНумерацииУпакованных",СтрокаНумерацииУпакованных);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаШККоробаДляПаллета", ЭтотОбъект, ПараметрыПослеУдачногоВвода);
		ОткрытьФорму("Обработка.УпаковкаВПаллеты.Форма.ВводКороба", ПараметрыДляВводаШККороба, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОзвучитьТекст("Паллет собран и готов к отгрузке");
		ТекстПодсказки = "Паллет полностью упакован.";
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаШККоробаДляПаллета(Результат, ПараметрыПослеУдачногоВвода) Экспорт
	/////////////////////////////////////////////////////////
	Если Результат <> Неопределено И Результат <> "" Тогда
		//обновляем РС по УпакованныеКороба
		ОбновитьРСУпакованныеКороба(Результат, ПараметрыПослеУдачногоВвода.ШКПаллета);
		
		//обновляем РС по ШтрихкодыПаллетов
		ОбновитьРСШтрихкодыПаллетов(ПараметрыПослеУдачногоВвода.ШКПаллета, ПараметрыПослеУдачногоВвода.СколькоУжеУпакованоВПаллет+1);
		
		//Обновляем таблицу
		ОбновитьДанныеНаСервере();
		
		//озвучиваем количество номер сколько уже упаковано в короб
		КоличествоУпакованных = ПараметрыПослеУдачногоВвода.СколькоУжеУпакованоВПаллет+1;
		ВместимостьПаллета = ПолучитьВместимостьПаллета(ПараметрыПослеУдачногоВвода.ШКПаллета);
		//ОзвучитьТекст(Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет");
		СтрокаНумерацииУпакованных = Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет";
		//Сообщить(Строка(КоличествоУпакованных) + " из " + Строка(ВместимостьПаллета) + " собрано в паллет");
		
		//проверяем вместимость
		ПаллетПолностьюУпакован = ПолучитьОтметкуЗаполненногоПаллета(ПараметрыПослеУдачногоВвода.ШКПаллета);
		Если ПаллетПолностьюУпакован = Неопределено Тогда
			Сообщить("Ошибка:Не удалось получить отметку заполненного паллета");
			Возврат;
		КонецЕсли;
		Если ПаллетПолностьюУпакован Тогда
			ОзвучитьТекст("Паллет собран и готов к отгрузке");
			ТекстПодсказки = "Упаковка в Паллет полностью завершена, все Штрихкоды коробов отсканированы";
			Возврат;
		КонецЕсли;
		
		//проверяем на упакованный ли короб
		//Если ПараметрыПослеУдачногоВвода.СколькоУжеУпакованоВПаллет+1 = БазоваяВместимостьПаллетов Тогда
		//	Сообщить("Упаковка в Паллет полностью завершена, все Штрихкоды коробов отсканированы");
		//	Возврат;
		//КонецЕсли;
		
		
		МассивСвободныхШКУпакованныхКоробов = Новый Массив;
		МассивСвободныхШКУпакованныхКоробов = ПолучитьШтрихкодыУпакованныхКоробов();
		
		Если МассивСвободныхШКУпакованныхКоробов = Неопределено Тогда
			ТекстПодсказки = "Закончились созданные упакованные короба, необходимо создать";
			Возврат;
		КонецЕсли;
		
		//Нужно передавать упакованные короба только с нужной номенклатурой
		Если ПараметрыПослеУдачногоВвода.МоноПаллет = Истина Тогда
			МассивСвободныхШКУпакованныхКоробов = ПолучитьШтрихкодыУпакованныхКоробовДляМонопаллета(ПараметрыПослеУдачногоВвода.ШтрихкодМонопаллета, ПараметрыПослеУдачногоВвода.ШКПаллета);
			Если МассивСвободныхШКУпакованныхКоробов = Неопределено Тогда
				ТекстПодсказки = "Еще не созданы упакованные короба для Монопаллета в которых есть Разрешенная номенклатура";
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДляВводаШККороба = Новый Структура;
		ПараметрыДляВводаШККороба.Вставить("МассивСвободныхШКУпакованныхКоробов", МассивСвободныхШКУпакованныхКоробов);
		ПараметрыДляВводаШККороба.Вставить("СколькоУжеУпакованоВПаллет", ПараметрыПослеУдачногоВвода.СколькоУжеУпакованоВПаллет+1);
		ПараметрыДляВводаШККороба.Вставить("ИспользуемыйСклад", Объект.ИспользуемыйСклад);
		ПараметрыДляВводаШККороба.Вставить("ШКПаллета",ПараметрыПослеУдачногоВвода.ШКПаллета);
		ПараметрыДляВводаШККороба.Вставить("СколькоВПоследнемПаллетеВместимость",Объект.СколькоВПоследнемПаллетеВместимость);
		ПараметрыДляВводаШККороба.Вставить("ДокументОснование",Объект.ДокументОснование);
		ПараметрыДляВводаШККороба.Вставить("СтрокаНумерацииУпакованных",СтрокаНумерацииУпакованных);
		ПараметрыДляВводаШККороба.Вставить("ЗаказПокупателяСсылка",Объект.ЗаказПокупателяСсылка);
		ПараметрыДляВводаШККороба.Вставить("МоноПаллет",ПараметрыПослеУдачногоВвода.МоноПаллет);
		ПараметрыДляВводаШККороба.Вставить("ШтрихкодМонопаллета",ПараметрыПослеУдачногоВвода.ШтрихкодМонопаллета);
		ПараметрыДляВводаШККороба.Вставить("Вместимость",ПараметрыПослеУдачногоВвода.Вместимость);
		
		ОбновленныеПараметрыПослеУдачногоВвода = Новый Структура;
		ОбновленныеПараметрыПослеУдачногоВвода.Вставить("ШКПаллета",ПараметрыПослеУдачногоВвода.ШКПаллета);
		ОбновленныеПараметрыПослеУдачногоВвода.Вставить("СколькоУжеУпакованоВПаллет", ПараметрыПослеУдачногоВвода.СколькоУжеУпакованоВПаллет+1);
		ОбновленныеПараметрыПослеУдачногоВвода.Вставить("МоноПаллет",ПараметрыПослеУдачногоВвода.МоноПаллет);
		ОбновленныеПараметрыПослеУдачногоВвода.Вставить("ШтрихкодМонопаллета",ПараметрыПослеУдачногоВвода.ШтрихкодМонопаллета);
		ОбновленныеПараметрыПослеУдачногоВвода.Вставить("Вместимость",ПараметрыПослеУдачногоВвода.Вместимость);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаШККоробаДляПаллета", ЭтотОбъект, ОбновленныеПараметрыПослеУдачногоВвода);
		ОткрытьФорму("Обработка.УпаковкаВПаллеты.Форма.ВводКороба", ПараметрыДляВводаШККороба, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// Пользователь нажал Отмена или закрыл диалог
		ТекстПодсказки = "Упаковка в паллет отменена";
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьРСУпакованныеКороба(ШККороба, ШКПаллета)
	
	Если ШККороба = "" Или ШККороба = Неопределено Тогда
		Сообщить("Ошибка: не указан штрихкод короба");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпакованныеКороба.Период КАК Период,
	|	УпакованныеКороба.ДокументОснование КАК ДокументОснование,
	|	УпакованныеКороба.ШККороба КАК ШККороба,
	|	УпакованныеКороба.ШКПаллета КАК ШКПаллета
	|ИЗ
	|	РегистрСведений.УпакованныеКороба КАК УпакованныеКороба
	|ГДЕ
	|	УпакованныеКороба.ДокументОснование = &ДокументОснование
	|	И УпакованныеКороба.ШККороба = &ШККороба";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("ШККороба", ШККороба);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	// 2. Обновляем найденные записи через набор записей
	Если Выборка.Следующий() Тогда
		НаборЗаписей = РегистрыСведений.УпакованныеКороба.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		НаборЗаписей.Отбор.ШККороба.Установить(Выборка.ШККороба);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.ШКПаллета = ШКПаллета;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		ТекстПодсказки = "Статус обновлен для упакованного короба: " + ШККороба;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРСШтрихкодыПаллетов(ШКПаллета, КоличествоУпакованных)
	
	Если ШКПаллета = "" Или ШКПаллета = Неопределено Тогда
		Сообщить("Ошибка: не указан штрихкод паллета");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыПаллетов.Период КАК Период,
	|	ШтрихкодыПаллетов.ДокументОснование КАК ДокументОснование,
	|	ШтрихкодыПаллетов.ШтрихкодПаллета КАК ШтрихкодПаллета,
	|	ШтрихкодыПаллетов.ПолностьюУпакован КАК ПолностьюУпакован,
	|	ШтрихкодыПаллетов.СколькоУпаковано КАК СколькоУпаковано,
	|	ШтрихкодыПаллетов.Вместимость КАК Вместимость
	|ИЗ
	|	РегистрСведений.ШтрихкодыПаллетов КАК ШтрихкодыПаллетов
	|ГДЕ
	|	ШтрихкодыПаллетов.ДокументОснование = &ДокументОснование
	|	И ШтрихкодыПаллетов.ШтрихкодПаллета = &ШтрихкодПаллета";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("ШтрихкодПаллета", ШКПаллета);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	// 2. Обновляем найденные записи через набор записей
	Если Выборка.Следующий() Тогда
		НаборЗаписей = РегистрыСведений.ШтрихкодыПаллетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		НаборЗаписей.Отбор.ШтрихкодПаллета.Установить(Выборка.ШтрихкодПаллета);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.СколькоУпаковано = КоличествоУпакованных;
			Если КоличествоУпакованных = Выборка.Вместимость Тогда
				Запись.ПолностьюУпакован = Истина;
			КонецЕсли;
			Если Выборка.Вместимость <> Объект.БазоваяВместимостьПаллетов И КоличествоУпакованных = Объект.СколькоВПоследнемПаллетеВместимость Тогда
				Запись.ПолностьюУпакован = Истина;
			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		ТекстПодсказки = "Статус обновлен для паллета: " + ШКПаллета;
	КонецЕсли;
	
КонецПроцедуры

