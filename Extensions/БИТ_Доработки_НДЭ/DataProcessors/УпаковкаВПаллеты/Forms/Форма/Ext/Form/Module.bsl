
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПроизводствоОснование") Тогда
		Объект.ДокументОснование = Параметры.ПроизводствоОснование;
		Объект.ЗаказПокупателяСсылка = Объект.ДокументОснование.ЗаказПокупателя;
		Объект.Контрагент = Объект.ЗаказПокупателяСсылка.Контрагент;
		Если Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("РВБ ООО") Тогда
			Объект.ИспользуемыйСклад = 2;
		ИначеЕсли Объект.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("ИНТЕРНЕТ РЕШЕНИЯ ООО") Тогда 
			Объект.ИспользуемыйСклад = 1;
		Иначе
			ВызватьИсключение("Неверный контрагент в заказе покупателя, необходимо указать РВБ ООО или ИНТЕРНЕТ РЕШЕНИЯ ООО");
		КонецЕсли;
	Иначе
		ВызватьИсключение("Нет основания документа производства или заказа покупателя!");
	КонецЕсли;
	
	Если Параметры.Свойство("ПроизводствоТЧ") Тогда
		//если что то нужно по ТЧ производству
	Иначе
		ВызватьИсключение("Нет строк в документе производства по ТЧ ""Продукция"" ");
	КонецЕсли;
	
	//Объект.ОбщееКоличествоКоробов = ПолучитьОбщееКоличествоКоробовПоДокументу();
	Объект.ОбщееКоличествоКоробов = ПолучитьОбщееКоличествоКоробовПоДокументуВерсияДва();
	Если Объект.ОбщееКоличествоКоробов = 0 Тогда
		ВызватьИсключение("Не созданы штрихкоды коробов в РС ДанныеПоКоробам!");
	КонецЕсли;
	
	//Рассчет вместимости у паллетов
	Объект.БазоваяВместимостьПаллетов = 30;
	Объект.СколькоВПоследнемПаллетеВместимость = 30;
	
	//Рассчет сколько палетов в общем
	Объект.СколькоПаллетовСоздать = Цел(Объект.ОбщееКоличествоКоробов/Объект.БазоваяВместимостьПаллетов);
	ДробнаяЧасть = Объект.ОбщееКоличествоКоробов/Объект.БазоваяВместимостьПаллетов;
	
	Если Объект.СколькоПаллетовСоздать <> ДробнаяЧасть Тогда//если есть дробная часть
		Объект.СколькоВПоследнемПаллетеВместимость = Объект.ОбщееКоличествоКоробов - Объект.СколькоПаллетовСоздать*Объект.БазоваяВместимостьПаллетов;
		Объект.СколькоПаллетовСоздать = Объект.СколькоПаллетовСоздать + 1;
	КонецЕсли;
	
	
	ТаблицаПаллетов = ПолучитьТаблицуВсехПаллетовПоДокументу();
	
	Если ТаблицаПаллетов = 0 ИЛИ ТаблицаПаллетов = Неопределено Тогда
		//создаемНовыеШК - записываем в регистр и в штрихкодыУпаковокИТоваров
		ТаблицаЗначенийШКПаллетов = СоздатьШтрихкодыПаллетов(Объект.СколькоПаллетовСоздать);
		Если ТаблицаЗначенийШКПаллетов = Неопределено Тогда
			ВызватьИсключение("Ошибка: Автоматическое создание паллетов!");
		КонецЕсли;
		ТекстПодсказки = ТекстПодсказки + "Штрихкоды паллетов созданы в количестве " + Строка(ТаблицаЗначенийШКПаллетов.Количество());
		//обновляем список
		ОбновитьДанныеНаСервере();
	Иначе
		//Выводим в ТЧ значения
		Для Каждого СтрокаТаблицы Из ТаблицаПаллетов Цикл
			НоваяСтрока = Объект.Паллеты.Добавить();
			НоваяСтрока.ШКПаллета = СтрокаТаблицы.ШтрихкодПаллета;
			НоваяСтрока.СколькоУпакованоКоробов = СтрокаТаблицы.СколькоУпаковано;
			НоваяСтрока.Вместимость = СтрокаТаблицы.Вместимость;
			НоваяСтрока.ПолностьюУпакован = СтрокаТаблицы.ПолностьюУпакован;
			НоваяСтрока.МоноПаллет = СтрокаТаблицы.МоноПаллет;
			НоваяСтрока.ШтрихкодМонопаллета = СтрокаТаблицы.ШтрихкодМонопаллета;
			НоваяСтрока.ОтветственнаяЗона = СтрокаТаблицы.ОтветственнаяЗона;
		КонецЦикла;
		
	КонецЕсли;
	
	
	
КонецПроцедуры 

&НаСервере
Функция СоздатьШтрихкодыПаллетов(Количество)
	//Автоматическое создание по каждому в ШтрихкодыУпаковокТоваров, после выдергиваем ШК из генератораШтрихкодов и Заполняем РС ШтрихкодыПаллетов
	
	//Формируем таблицу значений для записи в регистр
	ТаблицаЗначенийШКПаллетов = Новый ТаблицаЗначений;
	ТаблицаЗначенийШКПаллетов.Колонки.Добавить("Период");
	ТаблицаЗначенийШКПаллетов.Колонки.Добавить("ДокументОснование");
	ТаблицаЗначенийШКПаллетов.Колонки.Добавить("ШтрихкодПаллета");
	ТаблицаЗначенийШКПаллетов.Колонки.Добавить("Вместимость");
	
	//Если монопаллет - нужно поменять на количество равное количеству монопаллетов
	ТаблицаМонопаллетов = ПолучитьТаблицуВсехМоноПаллетовПоДокументу();
	//ШтрихкодыМонопаллетов.Период КАК Период,
	//ШтрихкодыМонопаллетов.ДокументОснование КАК ДокументОснование,
	//ШтрихкодыМонопаллетов.ШтрихкодМонопаллета КАК ШтрихкодМонопаллета,
	//ШтрихкодыМонопаллетов.НоменклатураДляМонопаллета КАК НоменклатураДляМонопаллета,
	//ШтрихкодыМонопаллетов.БаркодТовара КАК БаркодТовара,
	//ШтрихкодыМонопаллетов.ПорядковыйНомерМонопаллета КАК ПорядковыйНомерМонопаллета,
	//ШтрихкодыМонопаллетов.ШтрихкодПаллета КАК ШтрихкодПаллета,
	//ШтрихкодыМонопаллетов.ВместимостьМонопаллета КАК ВместимостьМонопаллета
	Если Не ТаблицаМонопаллетов = Неопределено Тогда
		Если ТаблицаМонопаллетов.Количество() > 0 Тогда
			
			ПредыдущийШКМонопаллета = 0;
			Количество = ТаблицаМонопаллетов.Количество();
			ВместимостьПаллета = ТаблицаМонопаллетов[0].ВместимостьМонопаллета;;
			Номер = 1;
			
			Пока Номер <> Количество+1 Цикл
				ЭтотШКМонопаллета = ТаблицаМонопаллетов[Номер-1].ШтрихкодМонопаллета;
				Если ПредыдущийШКМонопаллета <> 0 И ЭтотШКМонопаллета = ПредыдущийШКМонопаллета Тогда
					ВместимостьПаллета = ВместимостьПаллета + ТаблицаМонопаллетов[Номер-1].ВместимостьМонопаллета;
					ПредыдущийШКМонопаллета = ТаблицаМонопаллетов[Номер-1].ШтрихкодМонопаллета;
					Номер = Номер+1;
					Продолжить;
				КонецЕсли;
				Если ВместимостьПаллета > 30 Тогда
					ВызватьИсключение("Вместимость паллета больше 30 из-за общей вместимости монопаллета " + ТаблицаМонопаллетов[Номер-1].ШтрихкодМонопаллета);
				КонецЕсли;
				Стр = ТаблицаЗначенийШКПаллетов.Добавить();
				Стр.Период = ТекущаяДата();
				Стр.ДокументОснование = Объект.ДокументОснование;
				Стр.ШтрихкодПаллета = СоздатьЗаписьВШтрихкодыУпаковокИТоваровДляПаллета();
				Стр.Вместимость = ВместимостьПаллета;
				
				ВместимостьПаллета = ТаблицаМонопаллетов[Номер-1].ВместимостьМонопаллета;
				ПредыдущийШКМонопаллета = ТаблицаМонопаллетов[Номер-1].ШтрихкодМонопаллета;
				Номер = Номер+1;
				
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		Номер = 1;
		Пока Номер <> Количество+1 Цикл
			Стр = ТаблицаЗначенийШКПаллетов.Добавить();
			Стр.Период = ТекущаяДата();
			Стр.ДокументОснование = Объект.ДокументОснование;
			Стр.ШтрихкодПаллета = СоздатьЗаписьВШтрихкодыУпаковокИТоваровДляПаллета();
			Стр.Вместимость = Объект.БазоваяВместимостьПаллетов;
			Если Номер = Количество Тогда//если последний паллет, то у него может быть другая вместимость
				Стр.Вместимость = Объект.СколькоВПоследнемПаллетеВместимость;
			КонецЕсли;
			Номер = Номер+1;
		КонецЦикла;
	КонецЕсли;
	
	//если монопаллет - сначала изменяем записи и привязываемся между монопаллетами и паллетами по шк
	Если Не ТаблицаМонопаллетов = Неопределено Тогда
		Если ТаблицаМонопаллетов.Количество() > 0 Тогда
			
			//сначала проверяем количество монопаллетов и обычных паллетов
			ШКМонопаллетов = ТаблицаМонопаллетов.ВыгрузитьКолонку("ШтрихкодМоноПаллета");
			ШКМонопаллетов = СвернутьМассив(ШКМонопаллетов);
			Если ТаблицаЗначенийШКПаллетов.Количество() <> ШКМонопаллетов.Количество() Тогда
				ВызватьИсключение("Количество необходимых паллетов не совпадает с количеством Монопаллетов в заказе покупателя!");
			КонецЕсли;
			
			//Дальше необходимо связать монопаллеты и паллеты путем записи в регистр шк монопаллетов и добавлением колонки по шк паллетам
			ПредыдущийШКМонопаллета = ТаблицаМонопаллетов[0].ШтрихкодМонопаллета;
			Индекс = 0;
			Для Каждого СтрокаМонопаллета Из ТаблицаМонопаллетов Цикл
				
				Если СтрокаМонопаллета.ШтрихкодМонопаллета <> ПредыдущийШКМонопаллета Тогда
					Индекс = Индекс + 1;
					СтрокаМонопаллета.ШтрихкодПаллета = ТаблицаЗначенийШКПаллетов[Индекс].ШтрихкодПаллета;
					ПредыдущийШКМонопаллета = СтрокаМонопаллета.ШтрихкодМонопаллета;
				Иначе
					СтрокаМонопаллета.ШтрихкодПаллета = ТаблицаЗначенийШКПаллетов[Индекс].ШтрихкодПаллета;
					ПредыдущийШКМонопаллета = СтрокаМонопаллета.ШтрихкодМонопаллета;
				КонецЕсли;
				
			КонецЦикла;
			
			//теперь обновляем записи в регистре ШтрихкодыМонопаллетов
			ДокументОснование = ТаблицаМонопаллетов[0].ДокументОснование;//Получаем значения для отбора из первой строки
			НаборЗаписей = РегистрыСведений.ШтрихкодыМонопаллетов.СоздатьНаборЗаписей();// Пакетная запись в регистр
			НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);//Пакетная запись в регистр (удаляем старые записи по этому документу, записываем новые)
			НаборЗаписей.Прочитать();      // Читаем старые записи по этому отбору
			НаборЗаписей.Загрузить(ТаблицаМонопаллетов);  // Загружаем новые данные
			НаборЗаписей.Записать(Истина); // Истина = замещать старые записи новыми
			
			
			//Добавляем колонки по шк паллетам
			ТаблицаЗначенийШКПаллетов.Колонки.Добавить("МоноПаллет");
			ТаблицаЗначенийШКПаллетов.Колонки.Добавить("ШтрихкодМонопаллета");
			ТаблицаЗначенийШКПаллетов.Колонки.Добавить("ОтветственнаяЗона");
			Индекс = 0;
			Для Каждого СтрокаТаблицы Из ТаблицаЗначенийШКПаллетов Цикл
				
				СтрокаТаблицы.МоноПаллет = Истина;
				ШКМонопаллета = ТаблицаМонопаллетов.Найти(СтрокаТаблицы.ШтрихкодПаллета, "ШтрихкодПаллета");
				СтрокаТаблицы.ШтрихкодМонопаллета = ШКМонопаллета.ШтрихкодМоноПаллета;
				//записываем ответственные зоны
				РазрешеннаяНоменклатура = ПолучитьРазрешеннуюНоменклатуру(СтрокаТаблицы.ШтрихкодМонопаллета, СтрокаТаблицы.ШтрихкодПаллета);
				Если РазрешеннаяНоменклатура = Неопределено Тогда
					ВызватьИсключение("Не найдена номенклатура по монопаллету");
				КонецЕсли;
				Для каждого Строка Из РазрешеннаяНоменклатура Цикл
					ТаблицаОтветственнаяЗонаПоНоменклатуре = НайтиОтветственнуюЗонуПоРазрешеннойНоменклатуре(Строка.НоменклатураДляМонопаллета);
				КонецЦикла;
				Если ТаблицаОтветственнаяЗонаПоНоменклатуре = Неопределено Тогда
					ВызватьИсключение("Не найдена ответственная зона по монопаллету");
				КонецЕсли;
				СтрокаТаблицы.ОтветственнаяЗона = ТаблицаОтветственнаяЗонаПоНоменклатуре[0].ЗонаУпаковки;
				Индекс = Индекс + 1;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	//теперь записываем ТаблицаЗначенийШКПаллетов
	
	//Получаем значения для отбора из первой строки
	ДокументОснование = ТаблицаЗначенийШКПаллетов[0].ДокументОснование;
	
	// Пакетная запись в регистр
	НаборЗаписей = РегистрыСведений.ШтрихкодыПаллетов.СоздатьНаборЗаписей();
	
	//Пакетная запись в регистр (удаляем старые записи по этому документу, записываем новые)
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);
	
	НаборЗаписей.Прочитать();      // Читаем старые записи по этому отбору
	НаборЗаписей.Загрузить(ТаблицаЗначенийШКПаллетов);  // Загружаем новые данные
	НаборЗаписей.Записать(Истина); // Истина = замещать старые записи новыми
	
	ТекстПодсказки = "Данные успешно записаны в регистр ШтрихкодыПаллетов. Записей: " + ТаблицаЗначенийШКПаллетов.Количество() + ". Можно приступать к работе!";
	Возврат ТаблицаЗначенийШКПаллетов;
КонецФункции

&НаСервере
Функция НайтиОтветственнуюЗонуПоРазрешеннойНоменклатуре(НоменклатураДляМонопаллета)
	Если НоменклатураДляМонопаллета = "" Или НоменклатураДляМонопаллета = Неопределено Тогда
		Сообщить("Ошибка: не указана разрешенная номенклатура Монопаллета");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СборкаЗапасовПродукция.ЗонаУпаковки КАК ЗонаУпаковки
	|ИЗ
	|	Документ.СборкаЗапасов.Продукция КАК СборкаЗапасовПродукция
	|ГДЕ
	|	СборкаЗапасовПродукция.Ссылка = &Ссылка
	|	И СборкаЗапасовПродукция.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураДляМонопаллета);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		// Логирование ошибки (опционально)
		// ЗаписьЖурналаРегистрации("Ошибка запроса паллет", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	//Есть ли данные в результате
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Выгрузка результата с обработкой ошибок
	Попытка
		ТаблицаРазрешеннойНоменклатуры = РезультатЗапроса.Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ТаблицаРазрешеннойНоменклатуры;
КонецФункции

&НаСервере
Функция СвернутьМассив(ИсходныйМассив)
	уник = Новый Соответствие;
	
	Для Каждого Значение Из ИсходныйМассив Цикл
		уник[Значение] = Истина; // Ключом становится элемент массива
	КонецЦикла;
	
	СвернутыйМассив = Новый Массив;
	Для Каждого КлючЗначение Из уник Цикл
		СвернутыйМассив.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Возврат СвернутыйМассив;
КонецФункции

&НаСервере
Функция СоздатьЗаписьВШтрихкодыУпаковокИТоваровДляПаллета()
	
	// Устанавливаем привилегированный режим внутри функции
	УстановитьПривилегированныйРежим(Истина);
	
	//Генерируем через генератор ШК штрихкод паллета
	ПараметрыШтрихкода = Новый Структура;
	ПараметрыШтрихкода.Вставить("ЦифраРасширения", 1);
	ПараметрыШтрихкода.Вставить("ПрефиксКомпанииGS1", 466060592);
	ПараметрыШтрихкода.Вставить("СерийныйНомерSSCC",  ОпределитьПоследнийСерийныйНомер()+1);
	
	ШКПаллета = ШтрихкодыУпаковокКлиентСервер.ШтрихкодSSCC(ПараметрыШтрихкода);
	
	// Пытаемся найти существующий элемент
	СуществующийЭлемент = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", ШКПаллета);

	Если СуществующийЭлемент = Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка() Тогда
		// Элемент не найден — создаем новый
		НовыйЭлемент = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		НовыйЭлемент.ЗначениеШтрихкода = ШКПаллета;
		НовыйЭлемент.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка;
		НовыйЭлемент.ТипШтрихкода = Перечисления.ТипыШтрихкодов.SSCC;
		НовыйЭлемент.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		НовыйЭлемент.Количество = 1;
		НовыйЭлемент.Записать();
		//Сообщить("Создан новый элемент штрихкода паллета");
		Возврат ШКПаллета;
	Иначе
		// Элемент уже существует
		Сообщить("Элемент штрихкода паллета уже существует (" + ШКПаллета + ")");
		Возврат Неопределено;
	КонецЕсли;
	
	// Восстанавливаем предыдущий режим (опционально)
	 УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПриведенноеКДлинеЗначение(Знач ИсходнаяСтрока, Длина)
	Если ТипЗнч(ИсходнаяСтрока) = Тип("Число") Тогда
		Строка = Формат(ИсходнаяСтрока, "ЧН=0; ЧГ=0");
	Иначе
		Строка = СокрЛП(ИсходнаяСтрока);
	КонецЕсли;
	ТекущаяДлина = СтрДлина(Строка);
	Пока ТекущаяДлина < Длина Цикл
		Строка = "0" + Строка;
		ТекущаяДлина = ТекущаяДлина + 1;
	КонецЦикла;
	
	Возврат Строка;
КонецФункции

&НаСервере
Функция ОпределитьПоследнийСерийныйНомер()
	ПрефиксКомпанииGS1 = 466060592;
	ЦифраРасширения = 1;
	ЧастьШтрихкодаБезСкобок  = "00" + ЦифраРасширения + ПриведенноеКДлинеЗначение(ПрефиксКомпанииGS1, 9);
	ЧастьШтрихкодаСоСкобками = "(00)" + ЦифраРасширения + ПриведенноеКДлинеЗначение(ПрефиксКомпанииGS1, 9);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЧастьШтрихкода", ЧастьШтрихкодаСоСкобками + "%");
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	&ВыражениеСерийныйНомерSSCC КАК СерийныйНомерSSCC
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода ПОДОБНО &ЧастьШтрихкода
	|	И ШтрихкодыУпаковокТоваров.ТипШтрихкода В (
	|		ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC18),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC20))
	|
	|УПОРЯДОЧИТЬ ПО
	|	СерийныйНомерSSCC УБЫВ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражениеСерийныйНомерSSCC", "ПОДСТРОКА(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, 15, 7)");
	
	Результат = Запрос.Выполнить();
	ПоследнийНомерВБД = 0;
	
	Если Результат.Пустой() Тогда
		Запрос.Текст = ТекстЗапроса;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражениеСерийныйНомерSSCC", "ПОДСТРОКА(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, 13, 7)");
		Запрос.УстановитьПараметр("ЧастьШтрихкода", ЧастьШтрихкодаБезСкобок + "%");
		Результат = Запрос.Выполнить();
	КонецЕсли;
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ПоследнийНомерВБД = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Выборка.СерийныйНомерSSCC);
	КонецЕсли;
	Возврат ПоследнийНомерВБД;
	
КонецФункции

