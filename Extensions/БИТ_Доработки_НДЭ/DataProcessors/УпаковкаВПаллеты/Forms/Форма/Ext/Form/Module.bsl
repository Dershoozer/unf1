&НаСервере
Функция ПолучитьОбщееКоличествоКоробовПоДокументуВерсияДва()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СборкаЗапасовПродукция.Номенклатура.Ссылка КАК НоменклатураСсылка,
	|	СборкаЗапасовПродукция.Количество КАК Количество
	|ИЗ
	|	Документ.СборкаЗапасов.Продукция КАК СборкаЗапасовПродукция
	|ГДЕ
	|	СборкаЗапасовПродукция.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СколькоНеобходимоКоробов = 0;
	Пока Выборка.Следующий() Цикл
		ОбщееКоличествоНоменклатуры = Выборка.Количество;
		КоличествоВОдномКоробеВКарточкеНоменклатуры = ПолучитьЗначениеДопРеквизитаКороб(Выборка.НоменклатураСсылка);
		Если КоличествоВОдномКоробеВКарточкеНоменклатуры = Неопределено ИЛИ КоличествоВОдномКоробеВКарточкеНоменклатуры = 0 Тогда
			ВызватьИсключение("Не задано кол-во коробов в карточке номенклатуры!");
		КонецЕсли;
		НужноКоробов = Цел(ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры);
		ДробнаяЧасть = ОбщееКоличествоНоменклатуры/КоличествоВОдномКоробеВКарточкеНоменклатуры;
		Если  НужноКоробов <> ДробнаяЧасть Тогда
			НужноКоробов = НужноКоробов + 1;
		КонецЕсли;
		СколькоНеобходимоКоробов = СколькоНеобходимоКоробов + НужноКоробов;
	КонецЦикла;
	
	Возврат СколькоНеобходимоКоробов;
	
КонецФункции

