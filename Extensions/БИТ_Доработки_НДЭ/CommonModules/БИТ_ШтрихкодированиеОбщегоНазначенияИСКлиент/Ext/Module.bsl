// Функция для получения срока годности из реквизита номенклатуры
&НаСервере
Функция ПолучитьБитСрокГодности(Номенклатура) Экспорт
	
	Попытка
		// Пробуем обратиться к реквизиту напрямую (если он есть в метаданных)
		Возврат Номенклатура.Бит_СрокГодности;
	Исключение
		// Если реквизита нет, используем запрос
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.БИТ_СрокГодности КАК БитСрокГодности
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Номенклатура);
		
		Попытка
			Результат = Запрос.Выполнить().Выбрать();
			Если Результат.Следующий() Тогда
				Возврат Результат.БитСрокГодности;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// Функция для получения значения константы
&НаСервере
Функция ПолучитьБИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности() Экспорт
	Возврат Константы.БИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности.Получить();
КонецФункции