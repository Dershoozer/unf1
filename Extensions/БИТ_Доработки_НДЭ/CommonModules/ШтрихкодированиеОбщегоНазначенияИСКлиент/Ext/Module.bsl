// Общий модуль расширения для автоматического уточнения данных
// Переопределяем процедуру завершения обработки штрихкода

&Вместо("ЗавершитьОбработкуШтрихкода")
Процедура БИТ_ЗавершитьОбработкуШтрихкода(ПараметрыЗавершенияОбработкиШтрихкода) Экспорт
	
	Форма = ПараметрыЗавершенияОбработкиШтрихкода.Форма;
	РезультатОбработки = ПараметрыЗавершенияОбработкиШтрихкода.РезультатОбработкиШтрихкода;
	ПараметрыСканирования = ПараметрыЗавершенияОбработкиШтрихкода.ПараметрыСканирования;
	ДанныеШтрихкода = РезультатОбработки.ДанныеШтрихкода;
	
	// Если автозаполнение выключено - выполняем стандартную логику
	Если Не БИТ_ШтрихкодированиеОбщегоНазначенияИСКлиент.ПолучитьБИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности() Тогда
		ПродолжитьВызов(ПараметрыЗавершенияОбработкиШтрихкода);
		Возврат;
	КонецЕсли;
	
	// Проверяем, нужно ли открывать форму уточнения
	ТребуетсяУточнение = ТребуетсяУточнениеДанныхУПользователя(
	Форма, 
	РезультатОбработки, 
	ПараметрыСканирования
	);
	
	// Если уточнение не требуется - выполняем стандартную логику
	Если Не ТребуетсяУточнение Тогда
		ПродолжитьВызов(ПараметрыЗавершенияОбработкиШтрихкода);
		Возврат;
	КонецЕсли;
	
	// Если требуется уточнение, но у нас включено автозаполнение
	// Пытаемся автоматически заполнить все данные
	
	// 1. Заполняем срок годности из кода маркировки
	Если ЗначениеЗаполнено(ДанныеШтрихкода.ГоденДо) Тогда
		// Срок уже есть в данных
	ИначеЕсли ДанныеШтрихкода.СоставКодаМаркировки <> Неопределено
		И ЗначениеЗаполнено(ДанныеШтрихкода.СоставКодаМаркировки.ГоденДо) Тогда
		ДанныеШтрихкода.ГоденДо = ДанныеШтрихкода.СоставКодаМаркировки.ГоденДо;
	КонецЕсли;
	
	// 2. Если срок не найден в коде, пытаемся получить из номенклатуры
	Если Не ЗначениеЗаполнено(ДанныеШтрихкода.ГоденДо)
		И ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
		
		БитСрокГодности = БИТ_ШтрихкодированиеОбщегоНазначенияИСКлиент.ПолучитьБитСрокГодности(ДанныеШтрихкода.Номенклатура);
		Если ЗначениеЗаполнено(БитСрокГодности) Тогда
			ДанныеШтрихкода.ГоденДо = ДобавитьМесяц(ТекущаяДата(), БитСрокГодности);
		КонецЕсли;
	КонецЕсли;
	
	// 3. Проверяем, есть ли строка в дереве для заполнения
	Если Форма.СоответствиеШтрихкодовСтрокДерева <> Неопределено
		И Форма.ДеревоМаркированнойПродукции <> Неопределено Тогда
		
		ИдентификаторСтроки = Форма.СоответствиеШтрихкодовСтрокДерева.Получить(
		ДанныеШтрихкода.НормализованныйШтрихкод
		);
		
		Если ИдентификаторСтроки <> Неопределено Тогда
			СтрокаДерева = Форма.ДеревоМаркированнойПродукции.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если СтрокаДерева <> Неопределено Тогда
				
				// Заполняем данные в строке дерева
				Если ЗначениеЗаполнено(ДанныеШтрихкода.ГоденДо) И Не ЗначениеЗаполнено(СтрокаДерева.ГоденДо) Тогда
					СтрокаДерева.ГоденДо = ДанныеШтрихкода.ГоденДо;
				КонецЕсли;
				
				// Если номенклатура не заполнена, но есть в данных - заполняем
				Если Не ЗначениеЗаполнено(СтрокаДерева.Номенклатура) 
					И ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
					СтрокаДерева.Номенклатура = ДанныеШтрихкода.Номенклатура;
				КонецЕсли;
				
				// Если характеристика не заполнена, но есть в данных - заполняем
				Если Не ЗначениеЗаполнено(СтрокаДерева.Характеристика) 
					И ЗначениеЗаполнено(ДанныеШтрихкода.Характеристика) Тогда
					СтрокаДерева.Характеристика = ДанныеШтрихкода.Характеристика;
				КонецЕсли;
				
				// Если серия не заполнена, но есть в данных - заполняем
				Если Не ЗначениеЗаполнено(СтрокаДерева.Серия) 
					И ЗначениеЗаполнено(ДанныеШтрихкода.Серия) Тогда
					СтрокаДерева.Серия = ДанныеШтрихкода.Серия;
				КонецЕсли;
				
				// Обновляем статус проверки и пересчитываем итоги
				Если СтрокаДерева.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.НеПроверялась") Тогда
					СтрокаДерева.СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиНаличияПродукцииИС.ВНаличии");
				КонецЕсли;
				
				// Устанавливаем флаг модифицированности
				Форма.Модифицированность = Истина;
				
				// Пересчитываем итоги
				ПроверкаИПодборПродукцииИСМПКлиентСервер.ПересчитатьИтогиПоПроверкеСодержимогоУпаковки(СтрокаДерева, Ложь);
				ПроверкаИПодборПродукцииИСМПКлиентСервер.ПересчитатьИтогиПоПроверкеСодержимогоУпаковкиПриИзмененииСтроки(СтрокаДерева);
				
				// Убираем флаг необходимости уточнения
				РезультатОбработки.ТребуетсяУточнениеДанных = Ложь;
				РезультатОбработки.ТребуетсяВыборНоменклатуры = Ложь;
				РезультатОбработки.ОткрытьФормуВводаКодаМаркировки = Ложь;
				
				// Выполняем стандартное завершение, но уже без уточнения
				ПродолжитьВызов(ПараметрыЗавершенияОбработкиШтрихкода);
				
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Если не удалось заполнить автоматически - открываем форму уточнения
	// Сначала проверяем, есть ли у нас данные для уточнения из формы
	Если Форма.КодМаркировкиДляУточнения = Неопределено Тогда
		// Если код не установлен, создаем структуру для передачи
		Форма.КодМаркировкиДляУточнения = ПараметрыЗавершенияОбработкиШтрихкода;
	КонецЕсли;
	
	// Вызываем стандартную логику (откроется форма уточнения)
	ПродолжитьВызов(ПараметрыЗавершенияОбработкиШтрихкода);
	
КонецПроцедуры

// Вспомогательная функция для проверки необходимости уточнения
&Вместо("ТребуетсяУточнениеДанныхУПользователя")
Функция БИТ_ТребуетсяУточнениеДанныхУПользователя(Форма, РезультатОбработкиШтрихкода, ПараметрыСканирования) Экспорт
	
	// Получаем стандартный результат
	СтандартныйРезультат = ПродолжитьВызов(Форма, РезультатОбработкиШтрихкода, ПараметрыСканирования);
	
	// Если автозаполнение выключено - возвращаем стандартный результат
	Если Не БИТ_ШтрихкодированиеОбщегоНазначенияИСКлиент.ПолучитьБИТ_АвтоЗаполнениеПроверкиИПодбораПоСрокамГодности() Тогда
		Возврат СтандартныйРезультат;
	КонецЕсли;
	
	// Если стандартная логика говорит, что уточнение не нужно - возвращаем Ложь
	Если Не СтандартныйРезультат Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем, есть ли у нас данные для автоматического заполнения
	Если РезультатОбработкиШтрихкода <> Неопределено
		И РезультатОбработкиШтрихкода.ДанныеШтрихкода <> Неопределено Тогда
		
		ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
		
		// Проверяем наличие срока годности
		ЕстьСрокГодности = Ложь;
		Если ДанныеШтрихкода.Свойство("ГоденДо") И ЗначениеЗаполнено(ДанныеШтрихкода.ГоденДо) Тогда
			ЕстьСрокГодности = Истина;
		ИначеЕсли ДанныеШтрихкода.Свойство("СоставКодаМаркировки") И ДанныеШтрихкода.СоставКодаМаркировки <> Неопределено И ДанныеШтрихкода.СоставКодаМаркировки.Свойство("ГоденДо")
			И ЗначениеЗаполнено(ДанныеШтрихкода.СоставКодаМаркировки.ГоденДо) Тогда
			
			Если Не ДанныеШтрихкода.Свойство("ГоденДо") Тогда
				ДанныеШтрихкода.Вставить("ГоденДо", ДанныеШтрихкода.СоставКодаМаркировки.ГоденДо);
			Иначе
				ДанныеШтрихкода.ГоденДо = ДанныеШтрихкода.СоставКодаМаркировки.ГоденДо;
			КонецЕсли;
			ЕстьСрокГодности = Истина;
		КонецЕсли;
		
		// Если срока нет, но есть номенклатура - пробуем получить из реквизита
		Если Не ЕстьСрокГодности 
			И ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
			БитСрокГодности = БИТ_ШтрихкодированиеОбщегоНазначенияИСКлиент.ПолучитьБитСрокГодности(ДанныеШтрихкода.Номенклатура);
			Если ЗначениеЗаполнено(БитСрокГодности) Тогда
				ДанныеШтрихкода.ГоденДо = НачалоДня(ДобавитьМесяц(ТекущаяДата(), БитСрокГодности));
				ЕстьСрокГодности = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Если есть срок годности, проверяем остальные поля
		Если ЕстьСрокГодности Тогда
			
			// Проверяем, есть ли строка в дереве
			Если Форма.СоответствиеШтрихкодовСтрокДерева <> Неопределено
				И Форма.ДеревоМаркированнойПродукции <> Неопределено Тогда
				
				//ИдентификаторСтроки = Форма.СоответствиеШтрихкодовСтрокДерева.Получить(
				//ДанныеШтрихкода.НормализованныйШтрихкод
				//); 
				
				//Если ИдентификаторСтроки <> Неопределено Тогда
				//	СтрокаДерева = Форма.ДеревоМаркированнойПродукции.НайтиПоИдентификатору(ИдентификаторСтроки);
				//	Если СтрокаДерева <> Неопределено Тогда
				//		
				//		// Проверяем заполненность остальных полей
				//		НоменклатураЗаполнена = ЗначениеЗаполнено(СтрокаДерева.Номенклатура) 
				//		Или ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура);
				//		
				//		ХарактеристикаЗаполнена = (Не СтрокаДерева.ХарактеристикиИспользуются) 
				//		Или ЗначениеЗаполнено(СтрокаДерева.Характеристика)
				//		Или ЗначениеЗаполнено(ДанныеШтрихкода.Характеристика);
				//		
				//		СерияЗаполнена = (Не ИнтеграцияИСКлиентСервер.НеобходимоУказатьСерию(СтрокаДерева.СтатусУказанияСерий))
				//		Или ЗначениеЗаполнено(СтрокаДерева.Серия)
				//		Или ЗначениеЗаполнено(ДанныеШтрихкода.Серия);
				//		
				//		ВЕТИСЗаполнена = Истина;
				//		Если ПараметрыСканирования.Свойство("ЗаполнятьДанныеВЕТИС") 
				//			И ПараметрыСканирования.ЗаполнятьДанныеВЕТИС Тогда
				//			ВЕТИСЗаполнена = ЗначениеЗаполнено(СтрокаДерева.ИдентификаторПроисхожденияВЕТИС)
				//			Или ЗначениеЗаполнено(ДанныеШтрихкода.ИдентификаторПроисхожденияВЕТИС);
				//		КонецЕсли;
				//		
				//		// Если все поля могут быть заполнены - уточнение не требуется
				//		Если НоменклатураЗаполнена 
				//			И ХарактеристикаЗаполнена 
				//			И СерияЗаполнена 
				//			И ВЕТИСЗаполнена Тогда
				//			Возврат Ложь;
				//		КонецЕсли;
				//	КонецЕсли;
				//КонецЕсли;
				
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Иначе возвращаем стандартный результат
	Возврат СтандартныйРезультат;
	
КонецФункции
